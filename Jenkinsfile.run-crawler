#!/usr/bin/env groovy
// Skykiwi 爬虫任务
// 定时：每天 7:00 触发，随机延迟 10 分钟 - 12 小时（避免被检测）
pipeline {
    agent any

    triggers {
        // 每天 7:00 触发（H 表示 hash，用于分散负载）
        cron('H 7 * * *')
    }

    stages {
        stage('Run Crawler') {
            steps {
                script {
                    // 随机延迟 10 分钟 - 12 小时（避免被检测为机器人）
                    def minDelay = 600   // 10 分钟（秒）
                    def maxDelay = 43200 // 12 小时（秒）
                    def randomDelay = Math.abs(new Random().nextInt()) % (maxDelay - minDelay + 1) + minDelay
                    def delayHours = (randomDelay / 3600).intValue()
                    def delayMinutes = ((randomDelay % 3600) / 60).intValue()
                    def delaySeconds = randomDelay % 60

                    echo "⏰ 随机延迟：${delayHours}小时 ${delayMinutes}分钟 ${delaySeconds}秒（总计 ${randomDelay}秒）"
                    sleep(randomDelay)
                    echo "✅ 延迟结束，开始执行爬虫"
                }

                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        echo "=== 触发 Skykiwi Hobby 板块爬虫 ==="
                        ssh -i $SSH_KEY_FILE -o StrictHostKeyChecking=no -o ServerAliveInterval=10 root@192.168.100.1 \
                            "docker exec noda-ops bash -c 'cd /app/crawler && /app/crawler-venv/bin/python3 crawl-skykiwi.py --board hobby'"
                    '''
                }
            }
        }

        stage('Check Logs') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        echo "=== 检查爬虫日志 ==="
                        ssh -i $SSH_KEY_FILE -o StrictHostKeyChecking=no root@192.168.100.1 \
                            "docker exec noda-ops ls -lh /app/crawler/logs/ && echo && docker exec noda-ops cat /app/crawler/logs/llm_extract.log | tail -20"
                    '''
                }
            }
        }
    }
}
