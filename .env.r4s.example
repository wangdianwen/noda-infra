# ============================================
# r4s 环境变量模板
# ============================================
# 此文件是模板，实际值通过 Doppler CLI 动态注入（per D-16）
# 不应直接填写真实密钥
#
# 使用方式：
#   doppler secrets download --no-file --format docker > .env
#   docker compose -f docker/docker-compose.yml \
#     -f docker/docker-compose.prod.yml \
#     -f docker/docker-compose.r4s.yml up -d
#   rm .env  # 用完删除

# ============================================
# r4s 路径配置
# ============================================
# Docker 数据目录（D-15: 未来迁移到机械硬盘只需改此变量）
DOCKER_DATA_DIR=/mnt/mmc1-4/docker

# ============================================
# PostgreSQL 配置
# ============================================
POSTGRES_USER=CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=noda_prod

# ============================================
# Keycloak 配置
# ============================================
KEYCLOAK_ADMIN_USER=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# ============================================
# B2 云存储配置
# ============================================
B2_ACCOUNT_ID=CHANGE_ME
B2_APPLICATION_KEY=CHANGE_ME
B2_BUCKET_NAME=noda-backups
B2_PATH=backups/postgres/

# ============================================
# Cloudflare Tunnel 配置
# ============================================
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ============================================
# Doppler 配置
# ============================================
DOPPLER_TOKEN=CHANGE_ME

# ============================================
# SMTP 配置（Keycloak 密码重置邮件）
# ============================================
SMTP_HOST=CHANGE_ME
SMTP_PORT=587
SMTP_FROM=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME

# ============================================
# 告警配置
# ============================================
ALERT_EMAIL=CHANGE_ME
