# ============================================
# noda-apps 环境变量文件
# ============================================
# 用途：manage-containers.sh 使用 envsubst 替换 ${VAR} 占位符后，
#       生成的临时文件传给 docker run --env-file
#
# 变量分类：
#   静态硬编码 - 不随环境变化
#   动态替换   - ${VAR} 语法，由宿主机环境变量填充
#     POSTGRES_USER, POSTGRES_PASSWORD, RESEND_API_KEY

NODE_ENV=production
NEXT_PUBLIC_LOCAL_API_URL=http://localhost:3001
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod
KEYCLOAK_URL=https://auth.noda.co.nz
KEYCLOAK_INTERNAL_URL=http://noda-infra-nginx
KEYCLOAK_REALM=noda
KEYCLOAK_CLIENT_ID=noda-frontend
# admin 后端 introspect 用 confidential client admin-dashboard（secret 从 Doppler 注入）
KEYCLOAK_CLIENT_SECRET=${KEYCLOAK_CLIENT_SECRET}
RESEND_API_KEY=${RESEND_API_KEY}
ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}

# Email Service（运行时环境变量，非构建时）
KEYCLOAK_ADMIN_URL=http://noda-infra-nginx
KEYCLOAK_ADMIN_USER=${KEYCLOAK_ADMIN_USER}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}
TOKEN_SECRET=${TOKEN_SECRET}
EMAIL_SERVICE_API_KEY=${EMAIL_SERVICE_API_KEY}
AUTH_APP_URL=http://localhost:3004
NEXT_PUBLIC_AUTH_APP_URL=https://auth.noda.co.nz
RESEND_FROM_EMAIL=Noda <noreply@email.noda.co.nz>

# 2026-09 auth/comment 迁移：会话 cookie + Google OAuth 直连 + 评论服务
SESSION_COOKIE_NAME=noda_session
# Google OAuth 直连（client id/secret 从 Keycloak Google IdP 配置平移，Doppler 注入）
GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
GOOGLE_OAUTH_CLIENT_SECRET=${GOOGLE_OAUTH_CLIENT_SECRET}
# AUTH_STATE_SECRET：Google OAuth state HMAC 签名（缺省回退 TOKEN_SECRET）
AUTH_STATE_SECRET=${AUTH_STATE_SECRET}
# 评论服务：service key（X-Service-Key；openssl rand -hex 24 生成）
COMMENT_SERVICE_KEY=${COMMENT_SERVICE_KEY}
COMMENT_API_INTERNAL_URL=http://localhost:3012
# 邮件 token 密钥：apps/auth verifyEmailToken 与 email-service services/token.ts 共享
EMAIL_TOKEN_SECRET=${TOKEN_SECRET}

STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_PRICE_DEEP_READ=${STRIPE_PRICE_DEEP_READ}
LIUYAO_WEB_BASE_URL=${LIUYAO_WEB_BASE_URL}
ANTHROPIC_MAX_TOKENS=${ANTHROPIC_MAX_TOKENS}
