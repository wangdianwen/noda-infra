# ============================================
# noda-api（Go）prod 环境变量文件（三容器拆分）
# ============================================
# 用途：pipeline_deploy_prod() 使用 envsubst 替换 ${VAR} 占位符后，
#       生成的临时文件传给 docker run --env-file（/tmp/prod-api.env）
# 容器：noda-api-prod（Go 四端口：3001/3007/3010/3011）
# 与 frontend 模板（env-noda-frontend.env）的拆分原则：
#   API 侧持有 LLM/Stripe/Email 发送/爬虫密钥；会话与 OAuth 归 frontend

NODE_ENV=production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod

# 会话 cookie 名（Go API 校验 cookie）；CORS 允许来源（prod 六站点）
NEXT_PUBLIC_SESSION_COOKIE_NAME=noda_session
NEXT_PUBLIC_ALLOWED_ORIGINS=https://noda.co.nz,https://class.noda.co.nz,https://auth.noda.co.nz,https://www.noda.co.nz,https://admin.noda.co.nz,https://liuyao.noda.co.nz,https://comments.noda.co.nz

# Keycloak 内网端点（token introspection / admin；noda-infra-nginx 别名由 static 容器承载）
KEYCLOAK_INTERNAL_URL=http://noda-infra-nginx

# LLM（liuyao 起卦解卦，Anthropic 兼容网关）
ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MAX_TOKENS=${ANTHROPIC_MAX_TOKENS}

# Stripe（liuyao 支付，live key 由 Doppler prd 注入）
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_PRICE_DEEP_READ=${STRIPE_PRICE_DEEP_READ}
LIUYAO_WEB_BASE_URL=${LIUYAO_WEB_BASE_URL}

# Email（email-service :3010）
RESEND_API_KEY=${RESEND_API_KEY}
EMAIL_SERVICE_API_KEY=${EMAIL_SERVICE_API_KEY}
TOKEN_SECRET=${TOKEN_SECRET}
EMAIL_FROM=Noda <noreply@email.noda.co.nz>

# 内置 cron（爬虫/维护任务，Go 版）。旧 noda-ops python crawler 任务已删除（2026-09）；
# CRON_ENABLED=false 可临时关闭做对照
CRON_ENABLED=true
CRAWL_OUTPUT_DIR=/app/crawl-output

# Go 爬虫批次日志目录（镜像内已预留 tmpfs /app/crawler-logs）
CRAWLER_LOG_DIR=/app/crawler-logs

# ── Nearby（周边新鲜事，2026-09 M1）──
# :3014 listener；Eventfinda 凭证存 Doppler（prd/prd_pre），获取方式见 noda-apps 设计文档 §5.2.1
NEARBY_API_PORT=3014
NEARBY_OSM_ENABLED=true

# ── Snagme（Trade Me 捡漏监控，2026-09 接入）──
# :3015 listener（状态/采集历史/开火清单 JSON API）
SNAGME_API_PORT=3015
# Google News RSS 本地新闻抓取（2026-09-12 news.go）：条款灰色地带（non-commercial
# 标注，仅存标题+摘要+回链转介），如收到 Google 投诉改 false 一键关停
NEARBY_NEWS_ENABLED=true
EVENTFINDA_API_HOST=${EVENTFINDA_API_HOST}
EVENTFINDA_API_USERNAME=${EVENTFINDA_API_USERNAME}
EVENTFINDA_API_PASSWORD=${EVENTFINDA_API_PASSWORD}
