# ============================================
# noda-api（Go）prod 环境变量文件（三容器拆分）
# ============================================
# 用途：pipeline_deploy_prod() 使用 envsubst 替换 ${VAR} 占位符后，
#       生成的临时文件传给 docker run --env-file（/tmp/prod-api.env）
# 容器：noda-api-prod（Go 端口：3001/3010/3011；liuyao 3007 已随 2026-10-10 v2 清算摘除）
# 与 frontend 模板（env-noda-frontend.env）的拆分原则：
#   API 侧持有 LLM/Stripe/Email 发送/爬虫密钥；S5 后 OAuth 与会话签发同在
#   Go 容器（authapi :3004），Google OAuth 三键随本文件下发

NODE_ENV=production
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_prod

# 会话 cookie 名（Go API 校验 cookie）；CORS 允许来源（liuyao 已随 v2 清算摘除）
NEXT_PUBLIC_SESSION_COOKIE_NAME=noda_session
NEXT_PUBLIC_ALLOWED_ORIGINS=https://noda.co.nz,https://class.noda.co.nz,https://auth.noda.co.nz,https://www.noda.co.nz,https://admin.noda.co.nz,https://comments.noda.co.nz
# authapi/commentapi 服务端 CORS（compose 同名行同步；2026-09-16 对账补入）
ALLOWED_ORIGINS=https://noda.co.nz,https://class.noda.co.nz,https://auth.noda.co.nz,https://www.noda.co.nz,https://admin.noda.co.nz,https://comments.noda.co.nz

# Keycloak 内网端点（token introspection / admin；noda-infra-nginx 别名由 static 容器承载）
KEYCLOAK_INTERNAL_URL=http://noda-infra-nginx

# Google OAuth（authapi /api/auth/google/*；缺失即 login?error=google_not_configured）
GOOGLE_OAUTH_CLIENT_ID=${GOOGLE_OAUTH_CLIENT_ID}
GOOGLE_OAUTH_CLIENT_SECRET=${GOOGLE_OAUTH_CLIENT_SECRET}
# 多 Provider OAuth（2026-10-07；client id 空 = 登录页隐藏该按钮，运行时零影响）
WECHAT_OAUTH_CLIENT_ID=${WECHAT_OAUTH_CLIENT_ID}
WECHAT_OAUTH_CLIENT_SECRET=${WECHAT_OAUTH_CLIENT_SECRET}
FACEBOOK_OAUTH_CLIENT_ID=${FACEBOOK_OAUTH_CLIENT_ID}
FACEBOOK_OAUTH_CLIENT_SECRET=${FACEBOOK_OAUTH_CLIENT_SECRET}
APPLE_OAUTH_CLIENT_ID=${APPLE_OAUTH_CLIENT_ID}
X_OAUTH_CLIENT_ID=${X_OAUTH_CLIENT_ID}
X_OAUTH_CLIENT_SECRET=${X_OAUTH_CLIENT_SECRET}
AUTH_STATE_SECRET=${AUTH_STATE_SECRET}
# 评论服务间凭据（commentapi admin 端点 + adminapi 评论审核代理共用；Doppler prd）
COMMENT_SERVICE_KEY=${COMMENT_SERVICE_KEY}

# adminapi 管理员邮箱白名单（逗号分隔；与 docker-compose.apps-prod.yml 同步维护。
# 2026-09-16：middleware 安全缺省（空=拒绝所有）落地时只写了 compose，漏了本模板
# ——compose 不参与部署，真实 env 由此模板生成，导致生产白名单为空拒绝所有人）
ADMIN_ALLOWED_EMAILS=wangdw2012@gmail.com

# LLM（Anthropic 兼容网关；class/nearby ask 与爬虫共用）
ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MODEL=${ANTHROPIC_MODEL}
ANTHROPIC_MAX_TOKENS=${ANTHROPIC_MAX_TOKENS}
# 备 provider（2026-11-02 failover）：主（z.ai）provider 级失败（429/402/5xx/
# 连接错误）自动切备，配额耗尽/恢复零部署自动切换（Go 端 common/go/llm/client.go）
ANTHROPIC_FALLBACK_AUTH_TOKEN=${ANTHROPIC_FALLBACK_AUTH_TOKEN}
ANTHROPIC_FALLBACK_BASE_URL=${ANTHROPIC_FALLBACK_BASE_URL}
ANTHROPIC_FALLBACK_API_KEY=${ANTHROPIC_FALLBACK_API_KEY}
ANTHROPIC_FALLBACK_MODEL=${ANTHROPIC_FALLBACK_MODEL}

# Stripe（live key 由 Doppler prd 注入）
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_PRICE_DEEP_READ=${STRIPE_PRICE_DEEP_READ}

# Affiliate 出站改写（issue #53 最小闭环；Go SSR #seo-body 外链 sponsored 化。
# 追加式模板 {url}?... 已按终审 C1 判例原样替换——勿对 value 做 QueryEscape）
AFFILIATE_MATCH_HOSTS=${AFFILIATE_MATCH_HOSTS}
AFFILIATE_REDIRECT_TMPL=${AFFILIATE_REDIRECT_TMPL}
# Viator 第二联盟（issue #95 多平台分派：viator host 命中优先走 viator 模板；
# MATCH_HOSTS 未设默认 www.viator.com,viator.com；关闭改写=置空 REDIRECT_TMPL）
AFFILIATE_VIATOR_MATCH_HOSTS=${AFFILIATE_VIATOR_MATCH_HOSTS}
AFFILIATE_VIATOR_REDIRECT_TMPL=${AFFILIATE_VIATOR_REDIRECT_TMPL}

# Email（email-service :3010）
RESEND_API_KEY=${RESEND_API_KEY}
RESEND_WEBHOOK_SECRET=${RESEND_WEBHOOK_SECRET}
EMAIL_SERVICE_API_KEY=${EMAIL_SERVICE_API_KEY}
TOKEN_SECRET=${TOKEN_SECRET}
EMAIL_FROM=Noda <noreply@email.noda.co.nz>
RESEND_FROM_EMAIL=Noda <noreply@email.noda.co.nz>

# Telegram 告警（class 爬虫失败通知，api 与 noda-jobs 同享；值存 Doppler prd）
TELEGRAM_BOT_TOKEN=${TELEGRAM_BOT_TOKEN}
TELEGRAM_CHAT_ID=${TELEGRAM_CHAT_ID}

# 内置 cron（爬虫/维护任务，Go 版）。旧 noda-ops python crawler 任务已删除（2026-09）；
# CRON_ENABLED=false 可临时关闭做对照
CRON_ENABLED=true
# adminapi cron-pull（60s）拉取环注册表（2026-10-21 cron 全量盘点接入）：
# noda-jobs = 进程内调度器（代码默认，显式列出防漂移）；noda-ops-cron = noda-ops
# 容器 :3017 busybox httpd 上的静态心跳（shell 型 cron 经 hb.sh 上报，r4s 宿主
# 注意格式 = name:url 逗号分隔（cronpull.go parseServiceEndpoints 按首个冒号切分，勿用 = 号）
# 与 Mac 经 docker exec 同通道）。env 未列出的存量 service 会被自动置 inactive。
SERVICE_ENDPOINTS=noda-jobs:http://noda-jobs-prod:3016,noda-ops-cron:http://noda-ops:3017
CRAWL_OUTPUT_DIR=/app/crawl-output

# Go 爬虫批次日志目录（镜像内已预留 tmpfs /app/crawler-logs）
CRAWLER_LOG_DIR=/tmp/crawler-logs

# ── Nearby（周边新鲜事，2026-09 M1）──
# :3014 listener；Eventfinda 凭证存 Doppler（prd/prd_pre），获取方式见 noda-apps 设计文档 §5.2.1
NEARBY_API_PORT=3014
NEARBY_OSM_ENABLED=true
# OSM 定向补抓城市白名单（noda-apps #97）：逗号分隔 slug，空=全量 8 城（cron 日常口径）；
# 手动补抓示例：docker exec -d noda-jobs-prod sh -c "NEARBY_OSM_ENABLED=true NEARBY_OSM_CITIES=rotorua crawl-nearby council"
NEARBY_OSM_CITIES=
NEARBY_TRACK_MANIFEST_URL=
# ── council 议会开放数据源激活（noda-apps #187，2026-11-07）──
# 首源 Wellington City Council「WCC Playgrounds」：官方点图层（MapServer/49，
# gis.wcc.govt.nz），live 实测 111 条一页拉全（图 110/111、描述 110/111、打区 111/111）。
# URL 尾段数字=层号（adapter 参数化，#187；MapServer/FeatureServer 查询契约一致）。
# 数据集选型：Auckland Park Fixture Furniture 实证为街道家具（垃圾桶/自行车架/
# 桌椅，DESCRIPTION 值分布 top50 无 playground 类目），不适合作 playground 源。
# 换城市/数据集时改这一组键即可（Christchurch 等 council 同契约接入）。
# 注意：wellington.govt.nz 对数据中心 IP 有 403 WAF（WebFetch 实测在案，同
# OurAuckland 判例）——Picture_URL 镜像可能被拦，失败降级保留原 URL（浏览器
# 端仍可见），属预期；主查询端 gis.wcc.govt.nz 无此问题。
NEARBY_COUNCIL_FEATURESERVER_URL=https://gis.wcc.govt.nz/arcgis/rest/services/Parks/Parks/MapServer/49
NEARBY_COUNCIL_WHERE=1=1
# 标题链：正式名称 Asset_Description，兜底 Asset_Search_Description/Within_Location
NEARBY_COUNCIL_TITLE_FIELDS=Asset_Description,Asset_Search_Description,Within_Location
NEARBY_COUNCIL_TITLE_SUFFIX_FIELD=
# 描述链：WCC 官方英文整段描述（富化/翻译原料）；空字段链=不写描述
NEARBY_COUNCIL_DESC_FIELDS=web_description
# 图片链：官方照片 Picture_URL（http 自动升级 https 防 Mixed content）
NEARBY_COUNCIL_IMAGE_FIELDS=Picture_URL
NEARBY_COUNCIL_CITY=wellington
# 源标签：source_platform 落库值（区别于 osm 溯源；默认 aucklandcouncil）
NEARBY_COUNCIL_SOURCE=wellingtoncouncil
NEARBY_COUNCIL_CATEGORIES=playground
# 数据署名（CC BY 4.0 显著标注要求），追加在描述之后
NEARBY_COUNCIL_ATTRIBUTION=Wellington City Council, CC BY 4.0
# Plan 引擎（M4 ask，2026-09-18）：开关与每日配额（失败不计入配额）
NEARBY_ASK_ENABLED=true
NEARBY_ASK_DAILY_LIMIT=5
# EF 描述全文补全（2026-10-06，noda-apps 77df4416）：API 标准账户官方截断
# description 至 220 字符，截断行抓公开活动页补全文。FULLDESC=false 一键关停；
# DESC_LIMIT=efdesc 一次性回填批量；DESC_ID=uuid 定向单条（运维工具，恒空）
NEARBY_EF_FULLDESC_ENABLED=true
NEARBY_EF_DESC_LIMIT=150
NEARBY_EF_DESC_ID=
# true 时 efdesc 一次性扫尾把 expired 行也纳入回填（默认/空=只管 active，与 classify 周任务同口径）
NEARBY_EF_DESC_INCLUDE_EXPIRED=false

# #175 events 二批源（2026-11-06）：Humanitix sitemap 免 key 通道 + christchurchnz whats-on（chc DMO）。
# 均 opt-in：false/空=关。LIMIT=单轮 sitemap 详情页上限（空=代码默认 150）；
# WINDOW_HOURS=详情抓取窗口小时数（空=代码默认 72；存量追赶可临时调大如 720）
NEARBY_HUMANITIX_SITEMAP_ENABLED=true
NEARBY_HUMANITIX_SITEMAP_LIMIT=
NEARBY_HUMANITIX_SITEMAP_WINDOW_HOURS=
NEARBY_CHCNZ_ENABLED=true
# #181 events 三批源（2026-11-06）：奥克兰 aucklandlive / heartofthecity / aucklandforkids
# + 议会源 OurAuckland 激活（此前仅存豁免清单，从未进模板——「模板从未收录」实证）。
# 均 opt-in：false/空=关。LIMIT=单轮详情页/候选上限（空=代码默认：AUCKLANDLIVE 40 show、
# AKLFORKIDS 10 条 feed 候选）。
# 注意：OurAuckland 对数据中心 IP 有 403 WAF 实测在案（2026-11-06 探测），激活后
# 可能仍拉不到（报错日志即 WAF），属预期；DO 往返或出口 IP 变更后自然恢复。
NEARBY_OURAKL_ENABLED=true
NEARBY_AUCKLANDLIVE_ENABLED=true
NEARBY_AUCKLANDLIVE_LIMIT=
NEARBY_HEARTOFCITY_ENABLED=true
NEARBY_AKLFORKIDS_ENABLED=true
NEARBY_AKLFORKIDS_LIMIT=
# #192 events 批4源（2026-11-07）：惠灵顿官方 DMO WellingtonNZ（GraphQL 公网通道，
# Origin 头过 WAF，1 请求/轮，77 条旗舰活动）+ 奥克兰议会图书馆 Auckland Libraries
# （Coveo LibrariesEvent 索引，285 条实测，token 内置缺省可 env 覆写）。
# 均 opt-in：false/空=关。wellington.govt.nz 议会日历为 Eventfinda 白牌零增量，不接。
NEARBY_WGTNNZ_ENABLED=true
NEARBY_AKLLIB_ENABLED=true
# Coveo token 轮换覆写（空=代码内置公开 search token，一般无需配置）
NEARBY_AKLLIB_COVEO_TOKEN=
# Eventbrite 官方 API（凭据未签发前保持空/关；签发后 Doppler 写入即启用路径就绪）
NEARBY_EVENTBRITE_ENABLED=
EVENTBRITE_TOKEN=
NEARBY_EVENTBRITE_MAX_PAGES=
# 指南时效复核 job 每轮 LLM 复核条数上限（nz-living-guide T16）：升序取 lastFactsChecked 最旧的 N 篇；空=代码默认 50
NEARBY_GUIDE_REVIEW_LIMIT=50
# classify 重译压缩译文单轮上限（默认 400；一次性清债可临时调大）
NEARBY_RETRANSLATE_LIMIT=400

# Google News RSS 本地新闻抓取（2026-09-12 news.go）：条款灰色地带（non-commercial
# 标注，仅存标题+摘要+回链转介），如收到 Google 投诉改 false 一键关停
NEARBY_NEWS_ENABLED=true
NEARBY_NEWS_CITY_ENABLED=true
NEARBY_NEWS_CITY_LIMIT=150
NEARBY_OPS_QUOTA_BACKFILL_DAYS=7

# #117 booking 卡织入 / #118 周末路线周更（LLM 周任务门控，prod 开）
NEARBY_AFFILIATE_WEAVE_ENABLED=true
NEARBY_WEEKEND_ROUTES_ENABLED=true

# #139 菜谱内容线（LLM 原创生成 runner 门控，prod 开；随 api 发版 docker run 注入）。
# COUNT=目标道数（代码默认 30，幂等闸口径——已发布 ≥ 目标整跑跳过；调量用旋钮）
NEARBY_RECIPES_ENABLED=true
NEARBY_RECIPES_COUNT=30

# 优惠活动摄取（issue#10 D13，2026-10-16）：Google News 连锁促销 RSS + LLM 提取
# （glm-5.3-flash 批量）；NEARBY_DEALS_LLM_LIMIT=LLM 调用日上限（进程内存口径）
NEARBY_DEALS_ENABLED=true
NEARBY_DEALS_LLM_LIMIT=30
# issue25（2026-10-21）：deals 直接源（WS/TW/PB/SkyCity）标题三语化行数/日上限
# （crawl-nearby dealstranslate 存量回填 + dealsRun 尾步增量）
NEARBY_DEALS_TRANSLATE_LIMIT=60
EVENTFINDA_API_HOST=${EVENTFINDA_API_HOST}
EVENTFINDA_API_USERNAME=${EVENTFINDA_API_USERNAME}
EVENTFINDA_API_PASSWORD=${EVENTFINDA_API_PASSWORD}

# ── SeaweedFS S3 存储（blobstore：nearby 图片镜像等；凭据存 Doppler prd）──
# 2026-09-16 env 对账补入：compose 同名行是声明意图，prod 真实 env 只认本模板
S3_ENDPOINT=${S3_ENDPOINT}
S3_ACCESS_KEY=${S3_ACCESS_KEY}
S3_SECRET_KEY=${S3_SECRET_KEY}
S3_BUCKET=noda-static
NEARBY_STATIC_BUCKET=noda-static
# blobstore 公网 origin（mirror.go PutFromURL 产出 https://cdn.noda.co.nz/nearby/crawled/<key>；
# conf.d/cdn.conf 反代同桶）。2026-09-21 修复：只进 allowlist 未进本模板 → 容器恒空值，
# blobstore 校验失败永久降级直通，nearby 图片镜像自上线起从未生效
CDN_BASE_URL=https://cdn.noda.co.nz
# class 课程/分类深链页 head 注入拉壳的桶（page.go，同 NEARBY_STATIC_BUCKET 口径）
CLASS_STATIC_BUCKET=noda-static

# ── blobstore 双后端（#8 SeaweedFS 退役，2026-11；#123 关联）──
# fs = 读写容器内 /data/blobstore（_start_prod_api/_start_prod_jobs 已挂
# $PROD_STATIC_ROOT/cdn，r4s 静态根的 cdn/ 子树）；s3 = 既有 SeaweedFS 路径
# （回退锚）。直接值（非密钥，不经 envsubst 占位）：当前后端仍为 s3，M3 切换
# 时随 .backend-fs 标记入册改 fs；两键在 Go 侧（noda-apps M2）落地前无人消费
BLOBSTORE_MODE=fs
BLOBSTORE_FS_DIR=/data/blobstore

# ── GraphQL BFF + gRPC（2026-09-16 graphql-bff-grpc-design）──
# BFF :3060 = nginx 反代目标（api.noda.co.nz/graphql）；gRPC 4101/4104 仅容器内
# loopback，BFF 进程内直连。GRPC_CLIENT_TARGETS 留空=进程内直连（拆容器时才配）
BFF_PORT=3060
CLASS_GRPC_PORT=4101
AUTH_GRPC_PORT=4104
# emailapi 验证/重置邮件链接基址（#156：默认 localhost:3005 泄漏进 prod 邮件；
# verify-email 页在 auth 前端站——auth.noda.co.nz，非 apex）
AUTH_APP_URL=https://auth.noda.co.nz

# P2 扩产品 gRPC listener（2026-09-17 graphql-bff-grpc P2；仅容器内 loopback。
# LIUYAO_GRPC_PORT/SNAGME_GRPC_PORT 已随 2026-10-10 v2 清算摘除，代码默认值同原值）
COMMENT_GRPC_PORT=4112
ADMIN_GRPC_PORT=4111
NEARBY_GRPC_PORT=4114
# nearby 邮件周报令牌密钥（B3，2026-10-03）：确认/退订无状态 HMAC；
# 值存 Doppler project=noda（prd+prd_pre），空=周报面软关闭
NEWSLETTER_TOKEN_SECRET=${NEWSLETTER_TOKEN_SECRET}
# Web Push VAPID 密钥对（issue #147 周五推送）：公钥经 :3014
# /api/nearby/push/vapid-key 下发浏览器订阅；私钥仅 noda-jobs 发送端签名。
# 值存 Doppler project=noda（prd+prd_pre），任一缺失 = 订阅面隐藏 + cron 安全跳过
NEARBY_PUSH_VAPID_PUBLIC_KEY=${NEARBY_PUSH_VAPID_PUBLIC_KEY}
NEARBY_PUSH_VAPID_PRIVATE_KEY=${NEARBY_PUSH_VAPID_PRIVATE_KEY}
# T6（apex 批）：逗号分隔 job 名，noda-jobs 启动时跳过注册——snagme 下线期停四件；
# 对已删 job 名幂等容忍（T11 手术后 jobDefs 无 snagme 项，残留不报错）
NODA_DISABLED_JOBS=${NODA_DISABLED_JOBS}

# issue14 ops-metrics（admin 指标看板数据源，值由 Jenkins credentials 注入）
NEARBY_OPS_METRICS_ENABLED=true
GSC_SA_KEY_JSON=${GSC_SA_KEY_JSON}

# 新闻要点式 zh 增厚（issue #18 T3，2026-10-19）：newstranslate 单轮上限与
# 分片（CLI 批跑用；classify 日增量步同键默认 150 由代码侧自持）
NEARBY_NEWS_TRANSLATE_LIMIT=400
NEARBY_NEWS_TRANSLATE_SHARDS=1
NEARBY_NEWS_TRANSLATE_SHARD=0
# newstranslate 选行排序（issue #18 T3 2026-10-20）：desc=最新优先（feed 首屏
# 增厚），asc=最老优先清积压；缺省 asc。每日 classify 步由代码固定 DESC 不读本键
NEARBY_NEWS_TRANSLATE_ORDER=asc

# issue19 Admin3: ops_metrics 跳日守卫（10-17/18 抓取污染数据不回写，窗口滚过后可清）
NEARBY_OPS_METRICS_SKIP_DATES=2026-10-17,2026-10-18

# issue #54 三（DOC 步道）track 富化旋钮（2026-10-26）：两键均可缺省——
# MANIFEST_URL 缺省=线上 tracks-manifest.json；ENRICH_LIMIT 缺省=200 条/轮
NEARBY_TRACK_ENRICH_LIMIT=
# issue #103 2.4 素材富化精准回填：逗号分隔 slug 白名单（空=不过滤，
# cron nearby-content-enrich 渐进全量）
NEARBY_TRACK_ENRICH_SLUGS=
# nearby item 壳页基址（#123 fs 模式）：M5 cutover 后启用（nginx 8181 监听就绪后）
STATIC_SHELL_BASE_URL=http://noda-static-prod:8181

# issue #182 OurAuckland 浏览器会话通道（2026-11-07）：源站 Cloudflare 按无头
# 引擎指纹拦 403（UA/IP 无关），裸 HTTP 403 时经伴生有头 chromium 容器（compose
# 服务 ourauckland-cdp，Xvfb+CDP 9222）取渲染后 HTML。空/不可达=禁用 fallback
#（裸 HTTP 单通道，行为同改造前）。
NEARBY_CDP_URL=http://ourauckland-cdp:9222

# issue #218/#225 议会系统一详情管线旋钮（2026-11-08）：COUNCIL_DETAIL_LIMIT=回填
# 每轮限额（缺省 60）；_ID=定向单条回填；INCLUDE_EXPIRED=expired 扫尾；OA/AKLLIB/
