# ============================================
# Keycloak 环境变量文件
# ============================================
# 用途：manage-containers.sh 使用 envsubst 替换 ${VAR} 占位符后，
#       生成的临时文件传给 docker run --env-file
#
# 变量分类：
#   静态硬编码 - 不随环境变化
#   动态替换   - ${VAR} 语法，由宿主机环境变量填充
#     POSTGRES_USER, POSTGRES_PASSWORD,
#     KEYCLOAK_ADMIN_USER, KEYCLOAK_ADMIN_PASSWORD,
#     SMTP_HOST, SMTP_PORT, SMTP_FROM, SMTP_USER, SMTP_PASSWORD

# 数据库配置
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://noda-infra-postgres-prod:5432/keycloak
KC_DB_USERNAME=${POSTGRES_USER}
KC_DB_PASSWORD=${POSTGRES_PASSWORD}

# 主机名配置（v2 SPI - 使用完整 URL）
KC_HOSTNAME=https://auth.noda.co.nz
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
# KC_PROXY 已废弃，与 KC_PROXY_HEADERS 互斥（KC 25+），只留新版
KC_PROXY_HEADERS=xforwarded
KC_FRONTEND_URL=https://auth.noda.co.nz

# 健康检查（蓝绿部署容器健康检查）
KC_HEALTH_ENABLED=true

# JVM 内存（R4S 仅 4GB，近零流量调优，2026-09-05）
# -Xmx256m: 实测堆 used 仅 ~108MB，256m 上限余量 2.4 倍
# -XX:TieredStopAtLevel=1: 只用 C1 编译，代码缓存 ~50MB→~20MB（峰值性能略降，低流量无感）
# -Xss512k: 线程栈减半
# -XX:MaxMetaspaceSize=192m: 实测 Metaspace 138MB，192m 留 40% 余量防失控
# ⚠️ 不能加 -XX:+UseSerialGC：kc.sh 默认已带 -XX:+UseG1GC，双 GC 参数导致 JVM 拒绝启动
#    （"Multiple garbage collectors selected"，构建 #40 失败教训）
JAVA_OPTS_APPEND=-Xms64m -Xmx256m -XX:TieredStopAtLevel=1 -Xss512k -XX:MaxMetaspaceSize=192m

# 管理员账号
KEYCLOAK_ADMIN=${KEYCLOAK_ADMIN_USER}
KEYCLOAK_ADMIN_PASSWORD=${KEYCLOAK_ADMIN_PASSWORD}

# SMTP 配置（密码重置邮件）
KC_MAIL_HOST=${SMTP_HOST}
KC_MAIL_PORT=${SMTP_PORT}
KC_MAIL_FROM=${SMTP_FROM}
KC_MAIL_FROM_DISPLAY_NAME=Noda
KC_SMTP_AUTH=true
KC_SMTP_USER=${SMTP_USER}
KC_SMTP_PASSWORD=${SMTP_PASSWORD}
KC_SMTP_SSL=false
KC_SMTP_STARTTLS=true
