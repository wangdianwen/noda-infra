# ============================================
# noda-api（Go）preprod 环境变量文件（三容器拆分）
# ============================================
# 用途：pipeline_deploy_preprod() 使用 envsubst 替换后传给 docker run --env-file
# 容器：preprod-noda-api；与 prod 的区别：DATABASE_URL 指向 noda_preprod 数据库
# 密钥由部署脚本从 Doppler prd_pre 导出（test mode，与 prod live key 隔离）

NODE_ENV=production
NODA_ENV=preprod
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_preprod
DIRECT_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@noda-infra-postgres-prod:5432/noda_preprod

# 会话 cookie 名（preprod 独立名，Go API 校验 cookie 用）
NEXT_PUBLIC_SESSION_COOKIE_NAME=noda_session_preprod
NEXT_PUBLIC_ALLOWED_ORIGINS=https://class-preprod.noda.co.nz,https://auth-preprod.noda.co.nz,https://www-preprod.noda.co.nz,https://admin-preprod.noda.co.nz,https://liuyao-preprod.noda.co.nz,https://comments-preprod.noda.co.nz

# preprod Keycloak 直连（preprod 栈内容器）
KEYCLOAK_INTERNAL_URL=http://preprod-keycloak:8080

AUTH_BYPASS=false

# LLM（Anthropic 兼容网关；prd_pre 与 prd 同值，key 建好后替换 prd_pre 值）
ANTHROPIC_AUTH_TOKEN=${ANTHROPIC_AUTH_TOKEN}
ANTHROPIC_BASE_URL=${ANTHROPIC_BASE_URL}
ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY}
ANTHROPIC_MAX_TOKENS=${ANTHROPIC_MAX_TOKENS}

# Stripe test key（Doppler prd_pre）
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_WEBHOOK_SECRET=${STRIPE_WEBHOOK_SECRET}
STRIPE_PRICE_DEEP_READ=${STRIPE_PRICE_DEEP_READ}
LIUYAO_WEB_BASE_URL=${LIUYAO_WEB_BASE_URL}

# Email（email-service :3010）
RESEND_API_KEY=${RESEND_API_KEY}
EMAIL_SERVICE_API_KEY=${EMAIL_SERVICE_API_KEY}
TOKEN_SECRET=${TOKEN_SECRET}
EMAIL_FROM=Noda <noreply@email.noda.co.nz>

# 爬虫（preprod 限量）
CRAWL_POST_LIMIT=10
CRON_ENABLED=true
CRAWL_OUTPUT_DIR=/app/crawl-output

# Go 爬虫批次日志目录（镜像内已预留 tmpfs /app/crawler-logs）
CRAWLER_LOG_DIR=/app/crawler-logs

# ── Nearby（周边新鲜事，2026-09 M1）──
# :3014 listener；Eventfinda 凭证存 Doppler（prd/prd_pre），获取方式见 noda-apps 设计文档 §5.2.1
NEARBY_API_PORT=3014
# Snagme（Trade Me 捡漏监控）：:3015 listener
SNAGME_API_PORT=3015
NEARBY_OSM_ENABLED=true
EVENTFINDA_API_HOST=${EVENTFINDA_API_HOST}
EVENTFINDA_API_USERNAME=${EVENTFINDA_API_USERNAME}
EVENTFINDA_API_PASSWORD=${EVENTFINDA_API_PASSWORD}
