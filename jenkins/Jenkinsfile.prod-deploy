#!/usr/bin/env groovy
// Noda Platform - 生产全量部署 Pipeline
// Phase 26: 全服务部署 + DNS 切换
// 密钥从 Doppler (project=noda, config=prd) 加载

pipeline {
    agent any

    parameters {
        booleanParam(name: 'SKIP_TESTS', defaultValue: false, description: '跳过 E2E 测试（紧急部署用）')
        string(name: 'TAG', defaultValue: 'latest', description: 'Docker 镜像标签')
    }

    stages {
        stage('Checkout noda-platform') {
            steps {
                dir('noda-platform') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-platform.git',
                            credentialsId: 'noda-platform-git-credentials'
                        ]]
                    ])
                }
            }
        }

        stage('Sync Env from Doppler') {
            steps {
                sh 'cd noda-platform && bash deploy/prod/sync-env.sh'
            }
        }

        stage('Build All Images') {
            parallel {
                stage('Backend Services') {
                    steps {
                        sh '''
                            cd noda-platform
                            for svc in auth-service user-service course-service email-service admin-service crawler-service bff; do
                              docker build -f services/$svc/Dockerfile -t noda/$svc:${TAG} .
                            done
                        '''
                    }
                }
                stage('Frontend Apps') {
                    steps {
                        sh '''
                            cd noda-platform
                            docker build -f apps/findclass/Dockerfile -t noda/findclass:${TAG} .
                            docker build -f apps/auth/Dockerfile -t noda/auth-app:${TAG} .
                            docker build -f apps/admin/Dockerfile -t noda/admin-app:${TAG} .
                            docker build -f apps/www/Dockerfile -t noda/www:${TAG} .
                        '''
                    }
                }
            }
        }

        stage('Deploy to Prod') {
            steps {
                sh '''
                    cd noda-platform/deploy/prod
                    docker compose up -d
                '''
            }
        }

        stage('Health Check - All Services') {
            steps {
                sh '''
                    cd noda-platform/deploy/prod
                    echo "等待所有服务健康..."
                    for i in $(seq 1 36); do
                      HEALTHY=$(docker compose ps --format json 2>/dev/null | grep -c "healthy" || echo 0)
                      TOTAL=$(docker compose ps --services | wc -l | tr -d ' ')
                      echo "[$i/36] Healthy: $HEALTHY/$TOTAL"
                      if [ "$HEALTHY" -ge "$((TOTAL - 1))" ]; then
                        echo "✅ All services healthy"
                        docker compose ps
                        break
                      fi
                      sleep 5
                    done
                '''
            }
        }

        stage('Smoke Tests') {
            when { expression { params.SKIP_TESTS == false } }
            steps {
                sh '''
                    curl -sf http://localhost:3000/ || (echo "findclass FAILED" && exit 1)
                    curl -sf http://localhost:3001/ || (echo "auth FAILED" && exit 1)
                    curl -sf http://localhost:3002/ || (echo "admin FAILED" && exit 1)
                    curl -sf http://localhost:3003/ || (echo "www FAILED" && exit 1)
                    curl -sf http://localhost:4000/graphql?query={__schema{types{name}}} || (echo "BFF FAILED" && exit 1)
                    echo "✅ 全服务健康检查通过"
                '''
            }
        }

        stage('DNS Switch Ready') {
            steps {
                input message: '所有服务已健康运行。切换 Cloudflare DNS？', ok: '确认切换 DNS'
            }
        }
    }

    post {
        failure {
            sh 'cd noda-platform/deploy/prod && docker compose ps'
            echo '❌ 部署失败！检查日志: cd noda-platform/deploy/prod && docker compose logs'
        }
        success {
            echo '''
            ✅ 生产部署完成！

            DNS 切换后验证:
            - https://class.noda.co.nz
            - https://auth.noda.co.nz
            - https://admin.noda.co.nz
            - https://www.noda.co.nz
            - https://api.noda.co.nz/graphql

            保持老系统运行 48 小时以应对回滚。
            '''
        }
    }
}
