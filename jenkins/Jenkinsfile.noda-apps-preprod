#!/usr/bin/env groovy
// Noda Apps Pre-prod 单容器部署 Pipeline
// 5 阶段: Pre-flight -> Build -> Deploy -> Verify -> Cleanup
// 单容器: noda-apps-preprod（无蓝绿，直接停旧启新）
// 手动触发（无自动触发配置）

pipeline {
    agent any

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        NODA_ENVIRONMENT = 'preprod'
        CONTAINER_NAME = 'noda-apps-preprod'
        // Doppler Service Token（pre-prod 环境）
        DOPPLER_TOKEN = credentials('doppler-service-token-preprod')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
    }

    stages {
        stage('Pre-flight') {
            steps {
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                sh '''
                    source scripts/lib/log.sh

                    log_info "=========================================="
                    log_info "Pre-prod 单容器部署 Pipeline"
                    log_info "=========================================="
                    log_info "镜像: noda-apps:${GIT_SHA}"

                    # 检查 Docker daemon
                    docker info >/dev/null 2>&1 || {
                        log_error "Docker daemon 不可用"
                        exit 1
                    }
                    log_info "Docker daemon 可用"

                    # 检查 noda-network
                    docker network inspect noda-network >/dev/null 2>&1 || {
                        log_error "Docker 网络 noda-network 不存在"
                        exit 1
                    }
                    log_info "Docker 网络 noda-network 存在"

                    log_success "前置检查通过"
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    source scripts/lib/log.sh

                    log_info "构建 pre-prod 镜像..."

                    docker build \
                        -t noda-apps:latest \
                        -t "noda-apps:${GIT_SHA}" \
                        -f noda-apps/infra/docker/Dockerfile.noda-apps \
                        --build-arg NEXT_PUBLIC_KEYCLOAK_URL=https://pre.auth.noda.co.nz \
                        --build-arg NEXT_PUBLIC_KEYCLOAK_REALM=noda-preprod \
                        --build-arg NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=noda-frontend-preprod \
                        --build-arg NEXT_PUBLIC_AUTH_KEYCLOAK_CLIENT_ID=noda-auth-preprod \
                        noda-apps

                    log_success "镜像构建完成: noda-apps:${GIT_SHA}"
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/lib/secrets.sh
                    load_secrets

                    log_info "部署 pre-prod 容器..."

                    # 停止旧容器
                    if docker inspect "$CONTAINER_NAME" >/dev/null 2>&1; then
                        log_info "停止旧容器: $CONTAINER_NAME"
                        docker stop -t 30 "$CONTAINER_NAME"
                        docker rm "$CONTAINER_NAME"
                        log_success "旧容器已移除"
                    fi

                    # 准备环境变量文件
                    source scripts/manage-containers.sh || true  # source only, 不执行子命令
                    export SERVICE_NAME=noda-apps-preprod
                    tmp_env=$(prepare_env_file "single")

                    # 启动新容器
                    docker run -d \
                        --name "$CONTAINER_NAME" \
                        --network noda-network \
                        --restart unless-stopped \
                        --stop-timeout 30 \
                        --security-opt no-new-privileges \
                        --cap-drop ALL \
                        --read-only \
                        --tmpfs /tmp \
                        --tmpfs /app/scripts/logs \
                        --tmpfs /app/apps/auth/.next/cache:uid=1001,gid=1001,mode=0755 \
                        --tmpfs /app/apps/findclass/web/.next/cache:uid=1001,gid=1001,mode=0755 \
                        --tmpfs /app/apps/findclass/scripts/python/cache:uid=1001,gid=1001,mode=0755 \
                        --tmpfs /app/apps/findclass/scripts/python/logs:uid=1001,gid=1001,mode=0755 \
                        --tmpfs /app/apps/findclass/api/crawl-output:uid=1001,gid=1001,mode=0755 \
                        --memory 1g \
                        --memory-reservation 128m \
                        --cpus 1 \
                        --log-driver json-file \
                        --log-opt max-size=10m \
                        --log-opt max-file=3 \
                        ${tmp_env:+--env-file "$tmp_env"} \
                        --label noda.service-group=apps-preprod \
                        --label noda.environment=preprod \
                        --label com.docker.compose.project=noda-apps-pre-prod \
                        --health-cmd "wget --quiet --tries=1 --spider http://localhost:3000/api/health || exit 1" \
                        --health-interval 30s \
                        --health-timeout 10s \
                        --health-retries 3 \
                        --health-start-period 60s \
                        "noda-apps:${GIT_SHA}"

                    # 清理临时 env 文件
                    rm -f "$tmp_env"

                    log_success "容器 $CONTAINER_NAME 已启动"
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    source scripts/lib/log.sh

                    log_info "等待容器健康检查..."

                    # 等待容器变为 healthy（最多 120 秒）
                    max_wait=120
                    elapsed=0
                    while [ $elapsed -lt $max_wait ]; do
                        health=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' "$CONTAINER_NAME" 2>/dev/null || echo "unknown")
                        if [ "$health" = "healthy" ]; then
                            log_success "容器健康检查通过（等待 ${elapsed} 秒）"
                            break
                        fi
                        if [ "$elapsed" -ge "$max_wait" ]; then
                            log_error "容器健康检查超时（${max_wait} 秒），当前状态: $health"
                            docker logs "$CONTAINER_NAME" --tail 30
                            exit 1
                        fi
                        sleep 4
                        elapsed=$((elapsed + 4))
                    done

                    # HTTP 内部检查
                    log_info "HTTP 内部健康检查..."
                    for i in $(seq 1 10); do
                        if curl -sf "http://$CONTAINER_NAME:3000/api/health" >/dev/null 2>&1; then
                            log_success "HTTP 健康检查通过"
                            break
                        fi
                        if [ "$i" -eq 10 ]; then
                            log_error "HTTP 健康检查失败"
                            exit 1
                        fi
                        sleep 3
                    done

                    # 外部可达性检查
                    log_info "外部可达性检查..."
                    for i in $(seq 1 5); do
                        if curl -sf "https://pre.class.noda.co.nz/api/health" >/dev/null 2>&1; then
                            log_success "外部健康检查通过"
                            break
                        fi
                        if [ "$i" -eq 5 ]; then
                            log_error "外部健康检查失败（pre.class.noda.co.nz）"
                            exit 1
                        fi
                        sleep 3
                    done

                    log_success "Pre-prod 部署验证完成"
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/lib/image-cleanup.sh

                    log_info "清理旧镜像..."

                    # 清理 7 天前的旧镜像
                    cleanup_by_date_threshold "noda-apps" 7

                    # 清理 dangling images
                    cleanup_dangling

                    log_success "清理完成"
                '''
            }
        }
    }

    post {
        failure {
            script {
                sh '''
                    docker logs "$CONTAINER_NAME" --tail 50 >deploy-failure-container.log 2>&1 || true
                    docker logs noda-infra-nginx --tail 50 >deploy-failure-nginx.log 2>&1 || true
                '''
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "Pre-prod 部署成功: ${env.CONTAINER_NAME} (镜像: noda-apps:${env.GIT_SHA})"
            echo "外部验证: https://pre.class.noda.co.nz/api/health"
        }
    }
}
