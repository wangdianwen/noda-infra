#!/usr/bin/env groovy
// Noda Apps Promote to Prod Pipeline（简化版）
// 6 阶段: Pre-flight -> Deploy -> Health Check -> Switch -> Verify -> Cleanup
// 蓝绿部署: noda-apps-prod-blue / noda-apps-prod-green
// 手动触发，无 Human Approval，无 CDN Purge

pipeline {
    agent any

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        NODA_ENVIRONMENT = 'prod'
        ACTIVE_ENV = sh(
            script: 'cat /opt/noda/active-env 2>/dev/null || echo blue',
            returnStdout: true
        ).trim()
        TARGET_ENV = "${env.ACTIVE_ENV == 'blue' ? 'green' : 'blue'}"
        DOPPLER_TOKEN = credentials('doppler-service-token')
        DEPLOY_COLOR = "${env.TARGET_ENV}"
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('Pre-flight') {
            steps {
                script {
                    echo "=========================================="
                    echo "Promote to Prod Pipeline"
                    echo "=========================================="
                    echo "Active Environment: ${env.ACTIVE_ENV}"
                    echo "Target Environment: ${env.TARGET_ENV}"
                    echo "=========================================="
                }

                // 验证 pre-prod 镜像
                sh '''
                    source scripts/lib/log.sh

                    log_info "验证 pre-prod 环境..."

                    # 检查 pre-prod 容器是否运行中
                    if ! docker inspect noda-apps-preprod >/dev/null 2>&1; then
                        echo "ERROR: Pre-prod 容器不存在"
                        echo "请先运行 pre-prod pipeline 部署"
                        exit 1
                    fi

                    # 检查 pre-prod 容器是否健康
                    preprod_health=$(docker inspect --format='{{if .State.Health}}{{.State.Health.Status}}{{else}}none{{end}}' noda-apps-preprod 2>/dev/null || echo "unknown")
                    if [ "$preprod_health" != "healthy" ]; then
                        echo "ERROR: Pre-prod 容器不健康 (状态: $preprod_health)"
                        exit 1
                    fi
                    log_success "Pre-prod 容器健康"

                    # 获取 pre-prod 镜像 ID
                    PREPROD_IMAGE=$(docker inspect --format='{{.Image}}' noda-apps-preprod)
                    echo "$PREPROD_IMAGE" > /tmp/promote-image-id.txt
                    log_info "Pre-prod 镜像: ${PREPROD_IMAGE:0:12}..."

                    # 验证 pre-prod 外部可达性
                    if ! curl -sf "https://pre.class.noda.co.nz/api/health" >/dev/null 2>&1; then
                        echo "ERROR: Pre-prod 外部健康检查失败，不允许 promote"
                        exit 1
                    fi
                    log_success "Pre-prod 外部验证通过"
                '''

                script {
                    env.PREPROD_IMAGE_ID = sh(
                        script: 'cat /tmp/promote-image-id.txt',
                        returnStdout: true
                    ).trim()
                    echo "Promote 镜像: ${env.PREPROD_IMAGE_ID}"
                }

                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    # 检查 prod 状态文件
                    if [ ! -f "/opt/noda/active-env" ]; then
                        echo "WARNING: Prod 状态文件不存在，将初始化为 blue"
                        echo "blue" | sudo tee /opt/noda/active-env >/dev/null
                    fi

                    pipeline_preflight
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    # 使用 pre-prod 的镜像部署到 prod 蓝绿目标
                    pipeline_deploy "$TARGET_ENV" "$PREPROD_IMAGE_ID"
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    pipeline_health_check "$TARGET_ENV"

                    # Prod 容器 HTTP 检查
                    target_container=$(get_container_name "$TARGET_ENV")
                    curl -sf "http://$target_container:3000/api/health" || {
                        echo "ERROR: Prod 容器 HTTP 健康检查失败"
                        exit 1
                    }
                '''
            }
        }

        stage('Switch') {
            steps {
                script {
                    def upstreamFile = '/opt/noda/upstream/upstream.conf'
                    if (!fileExists(upstreamFile)) {
                        // 使用 manage-containers.sh 的 update_upstream，无需手动检查文件
                        echo "将使用 update_upstream() 切换流量"
                    }
                }

                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    pipeline_switch "$TARGET_ENV" "$ACTIVE_ENV"
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    pipeline_verify "$TARGET_ENV"

                    # 外部验证
                    curl -sf "https://class.noda.co.nz/api/health" || {
                        echo "ERROR: 外部健康检查失败"
                        exit 1
                    }
                '''
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh

                    export NODA_ENVIRONMENT=prod

                    pipeline_cleanup
                '''
            }
        }
    }

    post {
        failure {
            script {
                if (env.TARGET_ENV && env.TARGET_ENV != 'null') {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export NODA_ENVIRONMENT=prod
                        pipeline_failure_cleanup "$TARGET_ENV"
                    '''
                    archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
                } else {
                    echo 'Pipeline 在 TARGET_ENV 设置前失败，跳过日志归档'
                }
            }
        }
        success {
            script {
                echo "=========================================="
                echo "Promote to Prod 成功"
                echo "=========================================="
                echo "活跃环境: ${env.TARGET_ENV}"
                echo "外部验证: https://class.noda.co.nz/api/health"
                echo "=========================================="
            }
        }
    }
}
