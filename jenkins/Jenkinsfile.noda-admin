#!/usr/bin/env groovy
// Noda Admin Dashboard 部署 Pipeline
// 简化版：构建 + 部署 + 健康检查

pipeline {
    agent any

    environment {
        IMAGE_TAG = sh(
            script: 'date +%Y%m%d-%H%M%S',
            returnStdout: true
        ).trim()
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('Pre-flight') {
            steps {
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
            }
        }

        stage('Build') {
            steps {
                sh """
                    cd noda-apps
                    docker build \
                        -f apps/admin/Dockerfile \
                        -t noda-admin:${env.GIT_SHA} \
                        -t noda-admin:latest \
                        .
                """
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd ${WORKSPACE}/docker
                    docker compose -f docker-compose.admin.yml down || true
                    docker compose -f docker-compose.admin.yml up -d
                '''
            }
        }

        stage('Health Check') {
            steps {
                sh '''
                    echo "等待 admin 容器启动..."
                    for i in $(seq 1 15); do
                        if docker exec noda-admin wget --quiet --tries=1 --spider http://localhost:8001/api/admin/health 2>/dev/null; then
                            echo "Admin 容器健康检查通过"
                            exit 0
                        fi
                        echo "等待中... ($i/15)"
                        sleep 2
                    done
                    echo "健康检查超时，查看日志:"
                    docker logs noda-admin --tail 50
                    exit 1
                '''
            }
        }
    }

    post {
        failure {
            echo "Admin 部署失败: ${env.GIT_SHA}"
            sh 'docker logs noda-admin --tail 30 || true'
        }
        success {
            echo "Admin 部署成功: ${env.GIT_SHA}"
        }
    }
}
