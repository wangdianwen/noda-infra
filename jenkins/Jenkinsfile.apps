#!/usr/bin/env groovy
// 统一 Apps 部署 Pipeline
// 10 阶段: Pre-flight -> Build -> Test -> Deploy Pre-prod -> Health Check Pre-prod
//        -> Human Approval -> Deploy Prod（停旧启新 + 健康检查） -> Verify -> CDN Purge -> Cleanup
// Build Once: 镜像构建一次，先后部署到 pre-prod 和 prod
// 前置: noda-apps 仓库 main 分支

pipeline {
    agent any

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        DOPPLER_TOKEN = credentials('doppler-service-token')
        // 备份文件实际路径（Jenkins workspace 中无备份文件，需指向项目部署目录）
        // 按实际部署路径配置，本地开发: ~/Project/noda-infra/docker/volumes/backup
        BACKUP_HOST_DIR = "${HOME}/Project/noda-infra/docker/volumes/backup"
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('Pre-flight') {
            steps {
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_preflight "$WORKSPACE/noda-apps"
                    '''
                }
            }
        }

        stage('Build') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_build "$WORKSPACE/noda-apps" "$GIT_SHA"
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('noda-apps') {
                    sh '''
                        source "$WORKSPACE/scripts/lib/log.sh"
                        source "$WORKSPACE/scripts/pipeline-stages.sh"
                        pipeline_test "$PWD"
                    '''
                    echo '🧪 运行 Lint 检查...'
                    sh 'pnpm lint'
                    echo '✅ Lint 通过'
                    echo '🧪 运行单元测试...'
                    sh 'pnpm test'
                    echo '✅ 测试通过'
                }
            }
        }

        stage('Deploy Pre-prod') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_deploy_preprod "$GIT_SHA"
                    '''
                }
            }
        }

        stage('Health Check Pre-prod') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_health_check_preprod
                    '''
                }
            }
        }

        stage('Human Approval') {
            steps {
                timeout(time: 6, unit: 'HOURS') {
                    script {
                        def userInput = input(
                            message: """Pre-prod 部署完成，请验证：
  - 主应用: http://class.noda.test/
  - 认证: http://auth.noda.test/
  - 官网: http://www.noda.test/
  - 管理后台: http://admin.noda.test/
  镜像: noda-apps:${env.GIT_SHA}

  请选择下一步操作：""",
                            parameters: [
                                choice(name: 'ACTION', choices: ['deploy_prod', 'rebuild_preprod', 'abort'], description: '选择操作：\n- deploy_prod: 验证通过，部署到生产环境\n- rebuild_preprod: 重新部署 pre-prod（无需重新构建）\n- abort: 中止部署')
                            ]
                        )
                        env.DEPLOY_ACTION = userInput
                    }
                }
            }
        }

        stage('Rebuild Pre-prod') {
            when {
                expression { env.DEPLOY_ACTION == 'rebuild_preprod' }
            }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        echo "🔄 清理旧镜像和容器..."
                        # 停止并删除 pre-prod 容器
                        ssh -i "$SSH_KEY_FILE" root@192.168.100.1 "docker compose -f /opt/noda/docker-compose.yml -f /opt/noda/docker-compose.preprod.yml stop findclass-ssr"
                        ssh -i "$SSH_KEY_FILE" root@192.168.100.1 "docker compose -f /opt/noda/docker-compose.yml -f /opt/noda/docker-compose.preprod.yml rm -f findclass-ssr"
                        # 删除 pre-prod 使用的镜像
                        ssh -i "$SSH_KEY_FILE" root@192.168.100.1 "docker rmi noda-apps:${GIT_SHA} 2>/dev/null || true"
                        echo "✅ 清理完成，重新部署 Pre-prod..."
                        pipeline_deploy_preprod "$GIT_SHA"
                        pipeline_health_check_preprod
                        echo "✅ Pre-prod 重新部署完成，请验证后再次运行 Pipeline 选择 deploy_prod"
                    '''
                }
            }
        }

        stage('Deploy Prod') {
            when {
                expression { env.DEPLOY_ACTION == 'deploy_prod' }
            }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_deploy_prod "$GIT_SHA"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    # E2E 验证：通过 nginx 访问生产环境健康检查端点
                    for i in $(seq 1 5); do
                        if curl -sf --connect-timeout 5 --max-time 10 https://class.noda.co.nz/api/health; then
                            echo "E2E 验证通过 (attempt $i)"
                            exit 0
                        fi
                        sleep 2
                    done
                    echo "E2E 验证失败: class.noda.co.nz/api/health 不可达"
                    exit 1
                '''
            }
        }

        stage('CDN Purge') {
            steps {
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'cf-api-token', variable: 'CF_API_TOKEN'),
                            string(credentialsId: 'cf-zone-id', variable: 'CF_ZONE_ID')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                pipeline_purge_cdn
                            '''
                        }
                    } catch (Exception e) {
                        echo "CDN Purge 跳过: Cloudflare 凭据未配置 (${e.message})"
                    }
                }
            }
        }

        stage('Abort') {
            when {
                expression { env.DEPLOY_ACTION == 'abort' }
            }
            steps {
                script {
                    currentBuild.result = 'ABORTED'
                    echo "❌ 用户中止部署。Pre-prod 环境保持运行，可重新触发 Pipeline 验证后继续部署。"
                    error("用户中止部署")
                }
            }
        }

    }

    post {
        always {
            script {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE

                        # === 1. 释放部署锁（总是执行）===
                        pipeline_release_lock

                        # === 2. 清理旧镜像（总是执行，增强容错）===
                        # 即使前面步骤失败，也确保清理旧镜像释放磁盘空间
                        if [ "${DEPLOY_ACTION:-}" != "abort" ]; then
                            echo "🧹 执行镜像清理..."
                            pipeline_cleanup || {
                                echo "⚠️ 镜像清理部分失败，继续执行..."
                                # 至少清理悬空镜像
                                cleanup_dangling || true
                            }
                        else
                            echo "⏭️ 部署已中止，跳过镜像清理"
                        fi
                    '''
                }
            }
        }
        failure {
            script {
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "✅ 部署成功: noda-apps-prod (镜像: noda-apps:${env.GIT_SHA})"
        }
    }
}
