#!/usr/bin/env groovy
// 统一 Apps 部署 Pipeline（合并 5 个 Pipeline）
// 12 阶段: Pre-flight -> Build -> Test -> Deploy Pre-prod -> Health Check Pre-prod
//        -> Human Approval -> Deploy Prod -> Health Check Prod -> Switch -> Verify -> CDN Purge -> Cleanup
// Build Once: 镜像构建一次，先后部署到 pre-prod 和 prod
// 前置: noda-apps 仓库 main 分支

pipeline {
    agent any

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        ACTIVE_ENV = sh(
            script: 'cat /opt/noda/active-env 2>/dev/null || echo blue',
            returnStdout: true
        ).trim()
        TARGET_ENV = "${env.ACTIVE_ENV == 'blue' ? 'green' : 'blue'}"
        DOPPLER_TOKEN = credentials('doppler-service-token')
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
    }

    stages {
        stage('Pre-flight') {
            steps {
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_preflight "$WORKSPACE/noda-apps"
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_build "$WORKSPACE/noda-apps" "$GIT_SHA"
                '''
            }
        }

        stage('Test') {
            steps {
                dir('noda-apps') {
                    sh '''
                        source "$WORKSPACE/scripts/lib/log.sh"
                        source "$WORKSPACE/scripts/pipeline-stages.sh"
                        pipeline_test "$PWD"
                    '''
                    sh 'pnpm lint >lint-result.txt 2>&1 || echo "LINT_FAILED" >> lint-result.txt'
                    sh 'pnpm test >test-result.txt 2>&1 || echo "TEST_FAILED" >> test-result.txt'
                    script {
                        if (fileExists('lint-result.txt') && readFile('lint-result.txt').contains('LINT_FAILED')) {
                            echo "WARNING: pnpm lint 失败，详见 lint-result.txt"
                        }
                        if (fileExists('test-result.txt') && readFile('test-result.txt').contains('TEST_FAILED')) {
                            echo "WARNING: pnpm test 失败，详见 test-result.txt"
                        }
                    }
                }
            }
        }

        stage('Deploy Pre-prod') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_deploy_preprod "$GIT_SHA"
                '''
            }
        }

        stage('Health Check Pre-prod') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_health_check_preprod
                '''
            }
        }

        stage('Human Approval') {
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: """Pre-prod 部署完成，请验证：
  - 主应用: http://class.noda.dev/
  - 认证: http://auth.noda.dev/
  - 官网: http://www.noda.dev/
  - 管理后台: http://admin.noda.dev/
  镜像: noda-apps:${env.GIT_SHA}
  确认部署到生产环境？"""
                }
            }
        }

        stage('Deploy Prod') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_deploy "$TARGET_ENV" "$GIT_SHA"
                '''
            }
        }

        stage('Health Check Prod') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_health_check "$TARGET_ENV"
                '''
            }
        }

        stage('Switch') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_switch "$TARGET_ENV" "$ACTIVE_ENV"
                '''
            }
        }

        stage('Verify') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_verify "$TARGET_ENV"
                '''
            }
        }

        stage('CDN Purge') {
            steps {
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'cf-api-token', variable: 'CF_API_TOKEN'),
                            string(credentialsId: 'cf-zone-id', variable: 'CF_ZONE_ID')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                pipeline_purge_cdn
                            '''
                        }
                    } catch (Exception e) {
                        echo "CDN Purge 跳过: Cloudflare 凭据未配置 (${e.message})"
                    }
                }
            }
        }

        stage('Cleanup') {
            steps {
                sh '''
                    source scripts/lib/log.sh
                    source scripts/pipeline-stages.sh
                    pipeline_cleanup_preprod
                    pipeline_cleanup
                '''
            }
        }
    }

    post {
        failure {
            script {
                // 区分 pre-prod 阶段失败和 prod 阶段失败
                if (env.TARGET_ENV && env.TARGET_ENV != 'null') {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        pipeline_failure_cleanup "$TARGET_ENV"
                    '''
                    archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
                }
            }
        }
        success {
            echo "部署成功: 生产流量已切换到 ${env.TARGET_ENV} (镜像: noda-apps:${env.GIT_SHA})"
        }
    }
}
