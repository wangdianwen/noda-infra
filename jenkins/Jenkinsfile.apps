#!/usr/bin/env groovy
// noda-apps —— 产品应用发布 Pipeline（2026-09-14 简化：12 stages 收敛为 4）
// 必须单选一个产品（PRODUCT，无 all），再选择发布层（LAYER）：
//   api    = 后端：构建/部署 noda-api（Go 多模块单镜像，容器全产品共享，锁 apps-prod/apps-preprod 互斥）
//   static = 前端：该产品静态站构建 → stg 桶（preprod 验证）→ 审批 → prod 桶
//            （publish-<product> 锁 + 产品维度中继/端口，跨产品可并行）
//   all    = 一起：api + noda-static 反代镜像顺带刷新 + 产品静态站
// 流程（4 stages）:
//   Build（队列门禁 + Pre-flight + 镜像/静态产物一次构建）
//   → Deploy Pre-prod & Test（并行：容器部署 ‖ stg 桶发布 ‖ 测试挡板）
//   → Human Approval（含 rebuild_preprod 循环，收在 stage 内部）
//   → Deploy Prod（容器部署 / prod 桶发布 + E2E 验证 + CDN Purge 收尾）
// 性能语义（2026-09-14）：
//   - preprod 尽快可用：部署/桶发布（I/O）与测试（CPU）并行，不被 ~30m 测试阻塞
//   - prod 零编译：镜像/产物在 Build 产出一次，prod 只做传输+切换 / 桶 mirror
//   - 测试挡板语义不变：parallel 未全过不进入 Deploy Prod，prod 始终受测试保护
// DEPLOY_MODE 参数:
//   normal（默认）: preprod 部署验证 + 人工批准后才发 prod
//   fast: 紧急修复路径——Test 通过后直接发 prod，跳过 preprod 与人工批准。
//         仅用于确认无风险的 hotfix；测试挡板（Test 失败不发版）仍然生效
// 前置: noda-apps 仓库 main 分支

pipeline {
    // 4 槽位轮换 workspace——同 job 并发构建互不踩踏，
    // 同槽位串行时 node_modules/checkout 缓存仍可复用
    agent {
        node {
            label ''
            customWorkspace "${env.JOB_NAME}/ws-${env.BUILD_NUMBER.toInteger() % 4}"
        }
    }

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        DOPPLER_TOKEN = credentials('doppler-service-token')
        // 备份文件实际路径（Jenkins workspace 中无备份文件，需指向项目部署目录）
        // 按实际部署路径配置，本地开发: ~/Project/noda-infra/docker/volumes/backup
        BACKUP_HOST_DIR = "${HOME}/Project/noda-infra/docker/volumes/backup"
    }

    // 并行化：无 disableConcurrentBuilds——项目已按维度隔离，
    // 前端桶发布按产品互不覆盖（publish-<product> 锁 + 产品中继）；
    // 后端共享容器的切换由锁下沉到部署函数保证（deploy_preprod 持 apps-preprod、
    // deploy_prod 持 apps-prod），并发构建的容器切换依锁串行，构建/测试全程并行
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    parameters {
        choice(
            name: 'PRODUCT',
            choices: ['class', 'www', 'admin', 'liuyao', 'nearby', 'auth', 'comment', 'snagme'],
            description: '选择要发布的产品（必选其一，无 all）：class 主应用 / www 官网 / admin 管理后台 / liuyao 六爻 / nearby 附近 / auth 认证 / comment 评论 / snagme 捡漏监控（API :3015 + 静态看板）。后端 Go 测试只跑对应产品模块 + common'
        )
        choice(
            name: 'LAYER',
            choices: ['all', 'api', 'static'],
            description: '选择发布层：api=仅后端（Go API）；static=仅前端（该产品静态站，stg 桶验证后发 prod 桶）；all=前后端一起（含 noda-static 反代镜像顺带刷新）'
        )
        choice(
            name: 'DEPLOY_MODE',
            choices: ['normal', 'fast'],
            description: 'normal: preprod 验证 + 人工批准后发 prod；fast: 紧急修复——Test 通过直接发 prod，跳过 preprod 与人工批准（仅限确认无风险的 hotfix）。测试挡板两种模式下都生效'
        )
    }

    stages {
        stage('Build') {
            options {
                // 队列门禁等待 + checkout + preflight + docker build（Mac）+
                // 静态产物构建，常规 ~20m，45m 封顶
                timeout(time: 45, unit: 'MINUTES')
            }
            steps {
                // ① 队列门禁：同产品后触发构建在此等待（不开始实际构建），
                //    先到者完成后自动接棒；normal 模式审批前会主动释放
                //    （原独立 Queue Gate / Build Info / Pre-flight stage 收敛至此）
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_queue_gate "$PRODUCT"
                    '''
                }
                script {
                    // Stage View / Job 页一眼看出这次发布是什么
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.PRODUCT}/${params.LAYER}" + (params.DEPLOY_MODE == 'fast' ? ' ⚡fast' : '')
                    currentBuild.description = "产品 <b>${params.PRODUCT}</b> · 层 <b>${params.LAYER}</b>（api=后端 / static=前端 / all=一起） · 模式 ${params.DEPLOY_MODE}"
                }
                // CI 防线：workspace 内的 noda-apps 若是指向本地工作区的符号链接，
                // 会构建未提交代码且 cleanup 误删本地 node_modules——必须用真实 checkout
                sh 'if [ -L noda-apps ]; then rm -f noda-apps && echo "⚠️ 已移除 noda-apps 符号链接（CI 禁用本地工作区直连）"; fi'
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        extensions: [[$class: 'CleanBeforeCheckout']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        pipeline_preflight "$WORKSPACE/noda-apps"
                    '''
                }
                // ② 一次构建，两环境复用：镜像（api/all）+ 静态产物（static/all）。
                //    后端 preprod/prod 用同一 noda-api:<sha> 镜像（仅 env 不同）；
                //    前端 out/ 产物 Build 产出一次，stg/prod 两桶各 mirror 一次
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        if [ "${LAYER}" != "static" ]; then
                            pipeline_build "$WORKSPACE/noda-apps" "$GIT_SHA"
                        fi
                        if [ "${LAYER}" != "api" ]; then
                            pipeline_build_static_artifacts "$PRODUCT"
                        fi
                    '''
                }
            }
        }

        // 并行三臂（2026-09-14）：preprod 尽快可用——部署/桶发布（I/O）不等测试
        // （CPU）；测试挡板语义不变：parallel 未全过不进入后续，prod 始终受测试保护。
        //   LAYER=api    → 容器臂 + Test
        //   LAYER=static → 桶臂 + Test
        //   LAYER=all    → 三臂全跑
        //   fast 模式跳过两个 preprod 臂（Test 臂照跑——挡板仍在）
        stage('Deploy Pre-prod & Test') {
            options {
                // 并行臂：pre-prod 部署 ~5m / 桶发布+探活 ~5m / Test（pnpm install +
                // turbo + go）可达 ~30m
                timeout(time: 40, unit: 'MINUTES')
            }
            parallel {
                stage('Pre-prod 容器') {
                    when {
                        expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' }
                    }
                    steps {
                        withCredentials([
                            sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE'),
                            // prd_pre 专用 token：主 token 只授权 prd，读 prd_pre 会拿到空导出
                            // （曾致 preprod 容器继承 prd 的 live key）
                            string(credentialsId: 'doppler-service-token-preprod', variable: 'DOPPLER_TOKEN_PREPROD')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                export SSH_KEY_FILE
                                export DEPLOY_TARGET=local
                                pipeline_deploy_preprod "$GIT_SHA"
                                pipeline_health_check_preprod
                            '''
                        }
                    }
                }
                stage('Pre-prod 桶') {
                    when {
                        expression { params.LAYER != 'api' && params.DEPLOY_MODE == 'normal' }
                    }
                    steps {
                        withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export PRODUCT_FILTER="${PRODUCT}"
                                export SSH_KEY_FILE
                                # stg 桶（noda-static-stg）= preprod 验证环境；
                                # 发布后探活 *-preprod 公网链路，作为人工验证的前置关口。
                                # 函数级重试 1 次（build #60/#62 实证：构建高负载下本机
                                # seaweedfs-stg 会崩溃循环，函数内重试窗口可能全撞死墙）
                                pub_ok=0
                                for pub_attempt in 1 2; do
                                    if pipeline_publish_product "$PRODUCT" "stg"; then
                                        pub_ok=1
                                        break
                                    fi
                                    if [ "$pub_attempt" = "1" ]; then
                                        echo "⚠️ stg 发布第 1 次失败（stg S3 抖动?），30s 后整体重试..."
                                        sleep 30
                                    fi
                                done
                                [ "$pub_ok" = "1" ] || { echo "❌ stg 发布重试后仍失败"; exit 1; }
                                pipeline_verify_static_preprod "$PRODUCT"
                            '''
                        }
                    }
                }
                stage('Test') {
                    steps {
                        dir('noda-apps') {
                            sh '''
                                # 设置 PATH 包含 Node.js 和 pnpm
                                export PATH="$HOME/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
                                source "$WORKSPACE/scripts/lib/log.sh"
                                source "$WORKSPACE/scripts/pipeline-stages.sh"
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                # 按 PRODUCT_FILTER 用 turbo --filter 只跑对应包 +
                                # workspace 依赖 + Go 产品模块；Test 失败 = 发布挡板
                                pipeline_test "$PWD"
                            '''
                            echo '✅ Lint + 单元测试通过'
                        }
                    }
                }
            }
        }

        // 审批 + preprod 重建循环收口为一个 stage（2026-09-14，原 Human Approval /
        // Rebuild Pre-prod / Abort 三 stage 合并）：rebuild 循环收在 stage 内部；
        // 拒绝 input 即中止（Jenkins 天然 ABORTED，无需独立 Abort stage）
        stage('Human Approval') {
            when {
                expression { params.DEPLOY_MODE == 'normal' }
            }
            options { timeout(time: 6, unit: 'HOURS') }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_release_build_lock "$PRODUCT"
                    '''
                }
                script {
                    def preprodUrl = [class  : 'https://class-preprod.noda.co.nz/',
                                      www    : 'https://www-preprod.noda.co.nz/',
                                      admin  : 'https://admin-preprod.noda.co.nz/',
                                      liuyao : 'https://liuyao-preprod.noda.co.nz/',
                                      nearby : 'https://nearby-preprod.noda.co.nz/',
                                      auth   : 'https://auth-preprod.noda.co.nz/',
                                      comment: 'https://comments-preprod.noda.co.nz/',
                                      snagme : 'https://snagme-preprod.noda.co.nz/'][params.PRODUCT]
                    // API 探针路径按产品区分：nearby 域名未反代 /api/health（nginx 只通
                    // /api/nearby|user/*），审批提示与 E2E 探针同口径用公开 feed
                    def apiProbe = [nearby: '/api/nearby/feed?city=auckland&limit=1']
                        .getOrDefault(params.PRODUCT, '/api/health')
                    def userInput = input(
                        message: """Pre-prod 部署完成（产品: ${params.PRODUCT}，本发布内容: ${preprodUrl}），请验证：
  - 静态站经 preprod 桶伺服（stg 桶已发布并探活通过）
  - API 容器链路: <产品域>-preprod.noda.co.nz${apiProbe}
  镜像/内容: ${env.GIT_SHA}

  请选择下一步操作：""",
                        parameters: [
                            choice(name: 'ACTION', choices: ['deploy_prod', 'rebuild_preprod', 'abort'], description: '选择操作：\n- deploy_prod: 验证通过，部署到生产环境\n- rebuild_preprod: 重新部署 pre-prod（无需重新构建）\n- abort: 中止部署')
                        ]
                    )
                    // input 返回形状随提交方式变化（UI 提交=Map、空参批准=null/
                    // 空串、旧版=String）——不做形状假设，统一归一化：
                    // 显式 abort/rebuild_preprod 之外一律视为批准（deploy_prod）。
                    // 背景：归一化前 normal 模式曾静默跳过 prod 部署且显示 SUCCESS
                    // （apps#9/#11/#12/#15 连续实证，提交形状各异但 when 全部不命中）。
                    echo "Human Approval raw input: [${userInput}] class: ${userInput?.getClass()}"
                    def action = (userInput instanceof Map) ? userInput['ACTION'] : userInput
                    if (!['deploy_prod', 'rebuild_preprod', 'abort'].contains(action)) {
                        echo "DEPLOY_ACTION 归一化: [${action}] -> deploy_prod"
                        action = 'deploy_prod'
                    }
                    env.DEPLOY_ACTION = action

                    // rebuild 循环：重建 → 回到审批继续选（最多 5 轮），
                    // 按 LAYER 只重建触达层（容器 / stg 桶）
                    int round = 0
                    while (env.DEPLOY_ACTION == 'rebuild_preprod' && round < 5) {
                        round++
                        withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export SSH_KEY_FILE
                                pipeline_queue_gate "$PRODUCT"
                            '''
                        }
                        withCredentials([
                            sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE'),
                            string(credentialsId: 'doppler-service-token-preprod', variable: 'DOPPLER_TOKEN_PREPROD')
                        ]) {
                            sh """
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export LAYER_FILTER="\${LAYER}"
                                export PRODUCT_FILTER="\${PRODUCT}"
                                export SSH_KEY_FILE
                                echo "🔄 重新部署 Pre-prod（第 ${round} 轮，本机 Mac）..."
                                if [ "\${LAYER}" != "static" ]; then
                                    export DEPLOY_TARGET=local
                                    pipeline_deploy_preprod "\${GIT_SHA}"
                                    pipeline_health_check_preprod
                                fi
                                if [ "\${LAYER}" != "api" ]; then
                                    pipeline_publish_product "\${PRODUCT}" "stg"
                                    pipeline_verify_static_preprod "\${PRODUCT}"
                                fi
                            """
                        }
                        withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export SSH_KEY_FILE
                                pipeline_release_build_lock "$PRODUCT"
                            '''
                        }
                        def again = input(
                            message: "Pre-prod 已重建（第 ${round} 轮），请验证后选择下一步：",
                            parameters: [
                                choice(name: 'ACTION', choices: ['deploy_prod', 'rebuild_preprod', 'abort'], description: 'deploy_prod: 部署生产 / rebuild_preprod: 再重建一次 / abort: 中止')
                            ]
                        )
                        env.DEPLOY_ACTION = (again instanceof Map) ? again['ACTION'] : (again ?: 'deploy_prod')
                    }
                    if (env.DEPLOY_ACTION == 'rebuild_preprod') {
                        error("Rebuild Pre-prod 连续超过 5 轮，中止——请检查 preprod 环境后重新触发")
                    }
                }
            }
        }

        // prod 发布 + 验证 + CDN 收尾收敛为一个 stage（2026-09-14，原 Deploy Prod /
        // Publish Static / Verify / CDN Purge 四 stage 合并）。
        // 零编译：镜像/产物在 Build 产出，此处只做传输+切换 / 桶 mirror。
        stage('Deploy Prod') {
            when {
                expression { params.DEPLOY_MODE == 'fast' || env.DEPLOY_ACTION == 'deploy_prod' }
            }
            options {
                // 含门禁重取（其他构建持有队列锁时最长等 900s）+ prod 部署/桶发布 + E2E；
                // 15m 会被等锁独占导致部署没开始就被杀——45m
                timeout(time: 45, unit: 'MINUTES')
            }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        export DEPLOY_TARGET=r4s
                        # 审批窗口已释放队列锁——部署前重新获取（与其他构建的部署串行；
                        # 本构建已持锁时幂等跳过）
                        pipeline_queue_gate "$PRODUCT"
                        if [ "${LAYER}" != "static" ]; then
                            pipeline_deploy_prod "$GIT_SHA"
                        fi
                        if [ "${LAYER}" != "api" ]; then
                            pipeline_publish_product "$PRODUCT" "prod"
                        fi
                        # 产品维度 E2E：公网链路（Cloudflare → 边缘 → 桶/Go API）；
                        # snagme 走 r4s 边缘内探（不依赖公网 DNS）
                        pipeline_verify_product "$PRODUCT"
                    '''
                }
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'cf-api-token', variable: 'CF_API_TOKEN'),
                            string(credentialsId: 'cf-zone-id', variable: 'CF_ZONE_ID')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                # LAYER=api：容器镜像全产品共享，保持全域 purge_everything；
                                # static/all：只精准清除本产品入口 URL（全域 purge 会把
                                # 同 zone 其它产品的边缘缓存全部打掉）
                                if [ "${LAYER}" = "api" ]; then
                                    pipeline_purge_cdn
                                else
                                    pipeline_purge_cdn_urls "$PRODUCT"
                                fi
                            '''
                        }
                    } catch (Exception e) {
                        echo "CDN Purge 跳过: Cloudflare 凭据未配置 (${e.message})"
                    }
                }
            }
        }

    }

    post {
        always {
            script {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE

                        # === 1. 释放部署锁（总是执行，只放本构建登记的锁）===
                        pipeline_release_lock

                        # === 2. 清理旧镜像（总是执行；保留策略每仓库最新 2 版，
                        #        已部署镜像不受影响）===
                        echo "🧹 执行镜像清理..."
                        pipeline_cleanup || {
                            echo "⚠️ 镜像清理部分失败，继续执行..."
                            # 至少清理悬空镜像
                            cleanup_dangling || true
                        }
                    '''
                }
            }
        }
        failure {
            script {
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "✅ 产品 ${params.PRODUCT} 发布成功 (LAYER=${params.LAYER}, 镜像/内容: ${env.GIT_SHA})"
        }
    }
}
