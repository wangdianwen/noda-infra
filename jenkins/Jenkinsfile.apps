#!/usr/bin/env groovy
// noda-apps —— 产品应用发布 Pipeline（2026-09-13 由 apps-deploy 重构更名）
// 必须单选一个产品（PRODUCT，无 all），再选择发布层（LAYER）：
//   api    = 后端：构建/部署 noda-api（Go 多模块单镜像，容器全产品共享，锁 apps-prod/apps-preprod 互斥）
//   static = 前端：该产品静态站构建 + mc mirror 入 SeaweedFS 桶 sites/<product>/
//            （prod+stg 双桶同步收敛；publish-<product> 锁 + 产品维度中继/端口，跨产品可并行）
//   all    = 一起：api + noda-static 反代镜像顺带刷新 + 产品静态站
// 流程（保留原 apps-deploy 流程骨架）:
//   Pre-flight -> Build -> [Deploy Pre-prod ‖ Test] -> CDN Purge Pre-prod
//   -> Human Approval -> Deploy Prod -> Publish Static -> Verify -> CDN Purge -> Cleanup
//   （LAYER=static 时容器阶段全部跳过：Test 通过即桶发布，preprod 桶即为验证环境）
// DEPLOY_MODE 参数:
//   normal（默认）: preprod 部署验证 + 人工批准后才发 prod
//   fast: 紧急修复路径——Test 通过后直接发 prod，跳过 preprod 与人工批准。
//         仅用于确认无风险的 hotfix；测试挡板（Test 失败不发版）仍然生效
// 前置: noda-apps 仓库 main 分支

pipeline {
    // 4 槽位轮换 workspace——同 job 并发构建互不踩踏，
    // 同槽位串行时 node_modules/checkout 缓存仍可复用
    agent {
        node {
            label ''
            customWorkspace "${env.JOB_NAME}/ws-${env.BUILD_NUMBER.toInteger() % 4}"
        }
    }

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        DOPPLER_TOKEN = credentials('doppler-service-token')
        // 备份文件实际路径（Jenkins workspace 中无备份文件，需指向项目部署目录）
        // 按实际部署路径配置，本地开发: ~/Project/noda-infra/docker/volumes/backup
        BACKUP_HOST_DIR = "${HOME}/Project/noda-infra/docker/volumes/backup"
    }

    // 并行化（2026-09-13）：无 disableConcurrentBuilds——项目已按维度隔离，
    // 前端桶发布按产品互不覆盖（publish-<product> 锁 + 产品中继）；
    // 后端共享容器的切换由锁下沉到部署函数保证（deploy_preprod 持 apps-preprod、
    // deploy_prod 持 apps-prod），并发构建的容器切换依锁串行，构建/测试全程并行
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    parameters {
        choice(
            name: 'PRODUCT',
            choices: ['class', 'www', 'admin', 'liuyao', 'nearby', 'auth', 'comment', 'snagme'],
            description: '选择要发布的产品（必选其一，无 all）：class 主应用 / www 官网 / admin 管理后台 / liuyao 六爻 / nearby 附近 / auth 认证 / comment 评论 / snagme 捡露监控（仅后端，dashboard 为 Node 应用不支持静态发布）。后端 Go 测试只跑对应产品模块 + common'
        )
        choice(
            name: 'LAYER',
            choices: ['all', 'api', 'static'],
            description: '选择发布层：api=仅后端（Go API）；static=仅前端（该产品静态站桶发布）；all=前后端一起（含 noda-static 反代镜像顺带刷新）'
        )
        choice(
            name: 'DEPLOY_MODE',
            choices: ['normal', 'fast'],
            description: 'normal: preprod 验证 + 人工批准后发 prod；fast: 紧急修复——Test 通过直接发 prod，跳过 preprod 与人工批准（仅限确认无风险的 hotfix）。LAYER=static 时本参数不生效（桶发布即时生效）'
        )
    }

    stages {
        stage('Pre-flight') {
            steps {
                // CI 防线：workspace 内的 noda-apps 若是指向本地工作区的符号链接，
                // 会构建未提交代码且 cleanup 误删本地 node_modules——必须用真实 checkout
                sh 'if [ -L noda-apps ]; then rm -f noda-apps && echo "⚠️ 已移除 noda-apps 符号链接（CI 禁用本地工作区直连）"; fi'
                dir('noda-apps') {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        extensions: [[$class: 'CleanBeforeCheckout']],
                        userRemoteConfigs: [[
                            url: 'git@github.com:wangdianwen/noda-apps.git',
                            credentialsId: 'noda-apps-git-credentials'
                        ]]
                    ])
                }
                script {
                    env.GIT_SHA = sh(
                        script: 'git -C noda-apps rev-parse --short HEAD',
                        returnStdout: true
                    ).trim()
                }
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        pipeline_preflight "$WORKSPACE/noda-apps"
                    '''
                }
            }
        }

        stage('Build') {
            when { expression { params.LAYER != 'static' } }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        pipeline_build "$WORKSPACE/noda-apps" "$GIT_SHA"
                    '''
                }
            }
        }

        // Test 与 Pre-prod 部署并行：Build 阶段 Docker 已吃满 CPU，Test 跟 Build 并行只会互相抢；
        // Pre-prod 部署以 I/O 等待为主，正好塞入 Test。语义变化：测试失败时镜像可能已进
        // pre-prod（可接受，pre-prod 本就是验证环境），但 parallel 未全部通过不会进入
        // Human Approval，prod 始终受测试挡板保护。
        // LAYER=static 时无容器可部署——只跑 Test（发布挡板）。
        stage('Deploy Pre-prod & Test') {
            parallel {
                stage('Deploy Pre-prod') {
                    when {
                        expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' }
                    }
                    steps {
                        withCredentials([
                            sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE'),
                            // prd_pre 专用 token：主 token 只授权 prd，读 prd_pre 会拿到空导出
                            // （曾致 preprod 容器继承 prd 的 live key）
                            string(credentialsId: 'doppler-service-token-preprod', variable: 'DOPPLER_TOKEN_PREPROD')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                export SSH_KEY_FILE
                                export DEPLOY_TARGET=local
                                pipeline_deploy_preprod "$GIT_SHA"
                            '''
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                export SSH_KEY_FILE
                                export DEPLOY_TARGET=local
                                pipeline_health_check_preprod
                            '''
                        }
                    }
                }
                stage('Test') {
                    steps {
                        dir('noda-apps') {
                            sh '''
                                # 设置 PATH 包含 Node.js 和 pnpm
                                export PATH="$HOME/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/opt/homebrew/bin:$PATH"
                                source "$WORKSPACE/scripts/lib/log.sh"
                                source "$WORKSPACE/scripts/pipeline-stages.sh"
                                export LAYER_FILTER="${LAYER}"
                                export PRODUCT_FILTER="${PRODUCT}"
                                pipeline_test "$PWD"
                            '''
                            echo '🧪 运行 Lint 检查...'
                            sh 'export PATH="$HOME/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/opt/homebrew/bin:$PATH" && pnpm lint'
                            echo '✅ Lint 通过'
                            echo '🧪 运行单元测试...'
                            sh 'export PATH="$HOME/.nvm/versions/node/v24.12.0/bin:/usr/local/bin:/opt/homebrew/bin:$PATH" && pnpm test'
                            echo '✅ 测试通过'
                        }
                    }
                }
            }
        }

        stage('CDN Purge Pre-prod') {
            when {
                expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' }
            }
            steps {
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'cf-api-token', variable: 'CF_API_TOKEN'),
                            string(credentialsId: 'cf-zone-id', variable: 'CF_ZONE_ID')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                pipeline_purge_cdn
                            '''
                        }
                    } catch (Exception e) {
                        echo "CDN Purge 跳过: Cloudflare 凭据未配置 (${e.message})"
                    }
                }
            }
        }

        stage('Human Approval') {
            when {
                expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' }
            }
            steps {
                timeout(time: 6, unit: 'HOURS') {
                    script {
                        def userInput = input(
                            message: """Pre-prod 部署完成（产品: ${params.PRODUCT}，本机 Mac，双容器 api+static），请验证：
  - 主应用: https://class-preprod.noda.co.nz/
  - 六爻算卦: https://liuyao-preprod.noda.co.nz/
  - 官网静态: https://www-preprod.noda.co.nz/
  镜像: noda-api:${env.GIT_SHA} / noda-static:${env.GIT_SHA}

  请选择下一步操作：""",
                            parameters: [
                                choice(name: 'ACTION', choices: ['deploy_prod', 'rebuild_preprod', 'abort'], description: '选择操作：\n- deploy_prod: 验证通过，部署到生产环境\n- rebuild_preprod: 重新部署 pre-prod（无需重新构建）\n- abort: 中止部署')
                            ]
                        )
                        // input 带 parameters 时返回 Map（[ACTION:...]），直接赋给 env
                        // 会变成 "{ACTION=deploy_prod}"——Deploy Prod/Rebuild/abort 的
                        // when 条件因此永远不匹配（曾致 normal 模式静默跳过 prod 部署）
                        env.DEPLOY_ACTION = (userInput instanceof Map) ? userInput['ACTION'] : userInput
                    }
                }
            }
        }

        stage('Rebuild Pre-prod') {
            when {
                expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' && env.DEPLOY_ACTION == 'rebuild_preprod' }
            }
            steps {
                withCredentials([
                    sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE'),
                    string(credentialsId: 'doppler-service-token-preprod', variable: 'DOPPLER_TOKEN_PREPROD')
                ]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        export DEPLOY_TARGET=local
                        echo "🔄 重新部署 Pre-prod（本机 Mac）..."
                        pipeline_deploy_preprod "$GIT_SHA"
                        pipeline_health_check_preprod
                        echo "✅ Pre-prod 重新部署完成，请验证后再次选择 deploy_prod"
                    '''
                }
            }
        }

        stage('Deploy Prod') {
            when {
                expression { params.LAYER != 'static' && (params.DEPLOY_MODE == 'fast' || env.DEPLOY_ACTION == 'deploy_prod') }
            }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        export DEPLOY_TARGET=r4s
                        pipeline_deploy_prod "$GIT_SHA"
                    '''
                }
                }
            }
        }

        // 前端静态站发布（LAYER=static/all）：测试挡板之后执行。
        // prod+stg 双桶 mirror --remove 收敛 + 对象级对账 + 哨兵文件校验；
        // publish-<product> 锁 + 产品维度中继容器/端口/alias——跨产品并行互不覆盖
        stage('Publish Static') {
            when { expression { params.LAYER != 'api' } }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE
                        export DEPLOY_TARGET=r4s
                        pipeline_publish_product "$PRODUCT"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        export DEPLOY_TARGET=r4s
                        # 产品维度 E2E：公网链路（Cloudflare → 边缘 → 桶/Go API）；
                        # snagme 走 r4s 边缘内探（不依赖公网 DNS）
                        pipeline_verify_product "$PRODUCT"
                    '''
                }
                }
            }
        }

        stage('CDN Purge') {
            steps {
                script {
                    try {
                        withCredentials([
                            string(credentialsId: 'cf-api-token', variable: 'CF_API_TOKEN'),
                            string(credentialsId: 'cf-zone-id', variable: 'CF_ZONE_ID')
                        ]) {
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                pipeline_purge_cdn
                            '''
                        }
                    } catch (Exception e) {
                        echo "CDN Purge 跳过: Cloudflare 凭据未配置 (${e.message})"
                    }
                }
            }
        }

        stage('Abort') {
            when {
                expression { params.LAYER != 'static' && params.DEPLOY_MODE == 'normal' && env.DEPLOY_ACTION == 'abort' }
            }
            steps {
                script {
                    currentBuild.result = 'ABORTED'
                    echo "❌ 用户中止部署。Pre-prod 环境保持运行，可重新触发 Pipeline 验证后继续部署。"
                    error("用户中止部署")
                }
            }
        }

    }

    post {
        always {
            script {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export LAYER_FILTER="${LAYER}"
                        export PRODUCT_FILTER="${PRODUCT}"
                        export SSH_KEY_FILE

                        # === 1. 释放部署锁（总是执行，只放本构建登记的锁）===
                        pipeline_release_lock

                        # === 2. 清理旧镜像（总是执行，增强容错）===
                        # 即使前面步骤失败，也确保清理旧镜像释放磁盘空间
                        if [ "${DEPLOY_ACTION:-}" != "abort" ]; then
                            echo "🧹 执行镜像清理..."
                            pipeline_cleanup || {
                                echo "⚠️ 镜像清理部分失败，继续执行..."
                                # 至少清理悬空镜像
                                cleanup_dangling || true
                            }
                        else
                            echo "⏭️ 部署已中止，跳过镜像清理"
                        fi
                    '''
                }
            }
        }
        failure {
            script {
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "✅ 产品 ${params.PRODUCT} 发布成功 (LAYER=${params.LAYER}, 镜像/内容: ${env.GIT_SHA})"
        }
    }
}
