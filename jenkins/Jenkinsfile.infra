#!/usr/bin/env groovy
// noda-infra —— 公共基础设施镜像发布 Pipeline（2026-09-13 由 infra-deploy 重构更名）
// 职责：只发布公共 docker image —— nginx(反代镜像) / seaweedfs / noda-ops / postgres
//       必须单选一个服务，不提供 all（基础设施无"全量一键发布"，逐项可控）
// 产品前端静态站（class/www/admin/liuyao/nearby/auth/comment）不在此发布——
// 走 noda-apps Pipeline 的 LAYER=static（前端）路径，桶发布按产品隔离可并行
// keycloak 已于 2026-09-12 下线；remark42 不经 Pipeline 管理——相关路径全部移除
// 阶段: Pre-flight -> Backup(postgres) -> Human Approval(postgres) -> Deploy -> Health Check -> Verify
// 并行化（2026-09-13）：核心服务共用 infra-core 锁互斥（共享 compose 栈与边缘反代），
// 与 noda-apps（apps-preprod/apps-prod 锁）、静态站发布（publish-<product> 锁）维度
// 互不重叠——跨 Pipeline 可并行，无互相覆盖
// 注意：无 triggers 块 — 仅通过 "Build Now" 手动触发

pipeline {
    // 4 槽位轮换 workspace——同 job 并发构建互不踩踏，
    // 同槽位串行时 node_modules/checkout 缓存仍可复用
    agent {
        node {
            label ''
            customWorkspace "${env.JOB_NAME}/ws-${env.BUILD_NUMBER.toInteger() % 4}"
        }
    }

    environment {
        PATH = "/usr/local/bin:/opt/homebrew/bin:${env.PATH}"
        PROJECT_ROOT = "${WORKSPACE}"
        COMPOSE_BASE = "-f docker/docker-compose.yml -f docker/docker-compose.prod.yml"
        BACKUP_HOST_DIR = "${WORKSPACE}/docker/volumes/backup"
        // Doppler Service Token（Phase 40，per D-06/D-07）
        DOPPLER_TOKEN = credentials('doppler-service-token')
    }

    options {
        // Skip automatic checkout
        skipDefaultCheckout(true)
        // 无 disableConcurrentBuilds——并发安全由 infra-core 锁保证（不同 SERVICE 串行、
        // 跨 Pipeline 并行），4 个 workspace 槽位隔离并发构建
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    parameters {
        choice(
            name: 'SERVICE',
            choices: ['nginx', 'seaweedfs', 'noda-ops', 'postgres'],
            description: '''选择要发布的公共基础设施服务（必选其一，无 all）：
- nginx: 从 noda-apps 源码构建 noda-static 反代镜像 → 传输 r4s → 容器重建（配置经卷挂载即时生效）
- seaweedfs: 对象存储重建（S3 凭据 Doppler 注入，桶自动自愈）
- noda-ops: 备份 + Cloudflare Tunnel 容器重建（build 模式）
- postgres: 数据库容器重建（先备份 + 人工确认）'''
        )
    }

    stages {
        stage('Queue Gate') {
            steps {
                // ⚠️ 必须先 checkout：本 pipeline skipDefaultCheckout，工作区可能是
                // 任意旧提交——门禁 source 旧 pipeline-stages.sh 会用缺失/带病的
                // 函数集（#5 实证：ws-1 停在 a43a0cf，POSIX bug 触发语法错误）
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'git@github.com:wangdianwen/noda-infra.git', credentialsId: 'noda-infra-git-credentials']]
                ])
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_queue_gate "$SERVICE"
                    '''
                }
            }
        }
        stage('Build Info') {
            steps {
                script {
                    currentBuild.displayName = "#${env.BUILD_NUMBER} ${params.SERVICE}"
                    currentBuild.description = "公共基础设施服务 <b>${params.SERVICE}</b>（nginx / seaweedfs / noda-ops / postgres）"
                }
            }
        }
        stage('Pre-flight') {
            steps {
                // Simple checkout (no extensions to avoid git show-ref --tags -d hang)
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'git@github.com:wangdianwen/noda-infra.git', credentialsId: 'noda-infra-git-credentials']]
                ])
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_infra_preflight "$SERVICE"
                    '''
                }
            }
        }

        stage('Backup') {
            when {
                expression { params.SERVICE == 'postgres' }
            }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_backup_database "$SERVICE"
                    '''
                }
            }
        }

        stage('Human Approval') {
            when {
                expression { params.SERVICE == 'postgres' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                        sh '''
                            source scripts/lib/log.sh
                            source scripts/pipeline-stages.sh
                            export SSH_KEY_FILE
                            pipeline_release_build_lock "$SERVICE"
                        '''
                    }
                    input message: """确认重启 PostgreSQL?
                    服务: ${params.SERVICE}
                    影响范围: noda-apps、noda-ops 将短暂断连数据库
                    备份文件: 请查看上方 Backup 阶段日志
                    """.stripIndent(), ok: '确认重启'
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    // nginx = noda-static 反代镜像发布：镜像源码在 noda-apps 仓
                    // （Dockerfile.noda-static），构建一次传输 r4s，再由
                    // pipeline_deploy_nginx 以最新 tag 重建容器
                    script {
                        if (params.SERVICE == 'nginx') {
                            dir('noda-apps') {
                                checkout([
                                    $class: 'GitSCM',
                                    branches: [[name: '*/main']],
                                    userRemoteConfigs: [[
                                        url: 'git@github.com:wangdianwen/noda-apps.git',
                                        credentialsId: 'noda-apps-git-credentials'
                                    ]]
                                ])
                            }
                            sh '''
                                source scripts/lib/log.sh
                                source scripts/pipeline-stages.sh
                                export SSH_KEY_FILE
                                APPS_SHA=$(git -C noda-apps rev-parse --short HEAD)
                                pipeline_build_nginx_image "$WORKSPACE/noda-apps" "$APPS_SHA"
                            '''
                        }
                    }
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        # postgres 审批窗口已释放队列锁——部署前重新获取
                        pipeline_queue_gate "$SERVICE"
                        # infra-core 从 Deploy 起持有到 post 释放：动共享设施
                        # （compose 栈/边缘反代）期间其它核心服务互斥
                        pipeline_infra_core_enter
                        pipeline_infra_deploy "$SERVICE"
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_infra_health_check "$SERVICE"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_infra_verify "$SERVICE"
                    '''
                }
            }
        }

    }

    post {
        always {
            script {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE

                        # === 1. 释放部署锁（总是执行，只放本构建登记的锁）===
                        pipeline_release_lock

                        # === 2. 清理旧镜像（总是执行，增强容错）===
                        echo "🧹 执行基础设施服务清理: $SERVICE"
                        pipeline_infra_cleanup "$SERVICE" || {
                            echo "⚠️ 清理部分失败，尝试至少清理悬空镜像..."
                            cleanup_dangling || true
                        }
                    '''
                }
            }
        }
        failure {
            script {
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "✅ 公共基础设施服务 ${params.SERVICE} 发布成功"
        }
    }
}
