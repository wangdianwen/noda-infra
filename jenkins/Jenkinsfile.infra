#!/usr/bin/env groovy
// 统一基础设施 Jenkins Pipeline
// 7 阶段: Pre-flight -> Backup -> Human Approval -> Deploy -> Health Check -> Verify -> Cleanup
// 手动触发（无自动触发配置）
// 参数化服务选择: nginx / noda-ops / postgres / keycloak
// 整合说明: keycloak-deploy 已合并到此 Pipeline（2026-05-08）

pipeline {
    agent any

    environment {
        PROJECT_ROOT = "${WORKSPACE}"
        COMPOSE_BASE = "-f docker/docker-compose.yml -f docker/docker-compose.prod.yml"
        BACKUP_HOST_DIR = "${WORKSPACE}/docker/volumes/backup"
        // Doppler Service Token（Phase 40，per D-06/D-07）
        DOPPLER_TOKEN = credentials('doppler-service-token')
    }

    options {
        // 禁止并发构建，防止两个 Pipeline 同时操作基础设施服务
        disableConcurrentBuilds()
        // 保留最近 10 次构建日志
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    // 注意：无 triggers 块 — 仅通过 "Build Now" 手动触发

    parameters {
        choice(
            name: 'SERVICE',
            choices: ['nginx', 'noda-ops', 'keycloak', 'postgres'],
            description: '选择要部署的基础设施服务'
        )
        string(
            name: 'KEYCLOAK_IMAGE',
            defaultValue: 'quay.io/keycloak/keycloak:26.2.3',
            description: 'Keycloak 官方镜像（仅 keycloak 服务需要）'
        )
    }

    stages {
        stage('Pre-flight') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        if [ "$SERVICE" = "keycloak" ]; then
                            export SERVICE_IMAGE="${KEYCLOAK_IMAGE:-quay.io/keycloak/keycloak:26.2.3}"
                        fi
                        export SSH_KEY_FILE
                        pipeline_infra_preflight "$SERVICE"
                    '''
                }
            }
        }

        stage('Backup') {
            when {
                expression { params.SERVICE == 'postgres' }
            }
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_backup_database "$SERVICE"
                    '''
                }
            }
        }

        stage('Human Approval') {
            when {
                expression { params.SERVICE == 'postgres' }
            }
            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input message: """确认重启 PostgreSQL?
                    服务: ${params.SERVICE}
                    影响范围: Keycloak、findclass-ssr、noda-ops 将短暂断连数据库
                    备份文件: 请查看上方 Backup 阶段日志
                    """.stripIndent(), ok: '确认重启'
                }
            }
        }

        stage('Deploy') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        if [ "$SERVICE" = "keycloak" ]; then
                            export SERVICE_IMAGE="${KEYCLOAK_IMAGE:-quay.io/keycloak/keycloak:26.2.3}"
                        fi
                        export SSH_KEY_FILE
                        pipeline_infra_deploy "$SERVICE"
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_infra_health_check "$SERVICE"
                    '''
                }
            }
        }

        stage('Verify') {
            steps {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE
                        pipeline_infra_verify "$SERVICE"
                    '''
                }
            }
        }

    }

    post {
        always {
            script {
                withCredentials([sshUserPrivateKey(credentialsId: 'r4s-ssh-key', keyFileVariable: 'SSH_KEY_FILE')]) {
                    sh '''
                        source scripts/lib/log.sh
                        source scripts/pipeline-stages.sh
                        export SSH_KEY_FILE

                        # === 1. 释放部署锁（总是执行）===
                        pipeline_release_lock

                        # === 2. 清理旧镜像（总是执行，增强容错）===
                        # 即使前面步骤失败，也确保清理旧镜像释放磁盘空间
                        echo "🧹 执行基础设施服务清理: $SERVICE"
                        pipeline_infra_cleanup "$SERVICE" || {
                            echo "⚠️ 清理部分失败，尝试至少清理悬空镜像..."
                            cleanup_dangling || true
                        }
                    '''
                }
            }
        }
        failure {
            script {
                archiveArtifacts artifacts: 'deploy-failure-*.log', allowEmptyArchive: true
            }
        }
        success {
            echo "✅ 基础设施服务 ${params.SERVICE} 部署成功"
        }
    }
}
