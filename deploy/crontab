# Noda 数据库备份系统 - Crontab 配置
# dcron /etc/cron.d/ 格式: 分 时 日 月 周 命令（无 user 字段，用户由文件 owner 决定）

# 每天凌晨 3:00 执行备份
0 3 * * * /app/backup/backup-postgres.sh >> /app/crawler/logs/backup.log 2>&1

# 每周日凌晨 3:00 执行验证测试
0 3 * * 0 /app/backup/test-verify-weekly.sh >> /app/crawler/logs/test.log 2>&1

# 每 6 小时清理旧历史记录
0 */6 * * * /app/backup/lib/metrics.sh cleanup 2>/dev/null || true

# 每天凌晨 4:00 清理旧备份文件
0 4 * * * find /tmp/postgres_backups -type f -name "*.dump" -mtime +7 -delete 2>/dev/null || true

# 每天凌晨 3:30 执行 Doppler 密钥备份（错开数据库备份 3:00）
30 3 * * * /app/backup/backup-doppler-secrets.sh --project noda --config prd >> /app/crawler/logs/doppler-backup.log 2>&1

# 爬虫任务（脚本内随机延迟 10分钟-12小时，爬取后自动入库）
# Hobby (兴趣爱好): 每天 7:00 抓取第一页所有内容 + 入库
0 7 * * * /app/crawler/crawler-hobby.sh >> /var/log/noda-backup/crawler-hobby.log 2>&1
# Tutoring (课外辅导): 每周一 7:00 抓取第一页所有内容 + 入库
0 7 * * 1 /app/crawler/crawler-tutoring.sh >> /var/log/noda-backup/crawler-tutoring.log 2>&1

# 注意：Docker 镜像清理在 r4s 宿主机上通过 cron 执行
# 文件位置：/opt/noda/cleanup-docker-images.sh
# 执行时间：每周日凌晨 5:00 (root crontab)
