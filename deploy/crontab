# Noda 数据库备份系统 - Crontab 配置
# dcron /etc/cron.d/ 格式: 分 时 日 月 周 命令（无 user 字段，用户由文件 owner 决定）
# 注：supervisord 启动的 /usr/sbin/crond 是 dcron 4.5，默认读 /etc/cron.d（-s）
#     + /etc/crontabs（-c）两处——本文件烤入 /etc/cron.d/nodaops 即生效；
#     勿把内容复制到 /etc/crontabs，两处同读会双跑（2026-09-13 排查留档）

# 每天凌晨 3:00 执行备份
# 日志统一写 /var/log/noda-backup（卷挂载 docker/volumes/logs，持久化到宿主机）
0 3 * * * /app/backup/backup-postgres.sh >> /var/log/noda-backup/backup.log 2>&1

# 每周日凌晨 4:30 执行验证测试（2026-09-13 从 3:00 挪出：与每日备份同点撞车，
# verify 的 test_restore_* 库清理与 discover_databases 并发竞争导致双方互踩失败，
# 且遗留 test_restore_* 空库混入 discover 清单致每日备份整轮失败）
30 4 * * 0 /app/backup/test-verify-weekly.sh >> /var/log/noda-backup/test.log 2>&1

# 每 6 小时清理旧历史记录
0 */6 * * * /app/backup/lib/metrics.sh cleanup 2>/dev/null || true

# 每天凌晨 4:00 清理旧备份文件（与 RETENTION_DAYS=3 对齐，2026-09-13 由 7 收敛）
0 4 * * * find /tmp/postgres_backups -type f -name "*.dump" -mtime +3 -delete 2>/dev/null || true

# 每天凌晨 3:30 执行 Doppler 密钥备份（错开数据库备份 3:00）
30 3 * * * /app/backup/backup-doppler-secrets.sh --project noda --config prd >> /var/log/noda-backup/doppler-backup.log 2>&1

# 文件系统备份（2026-09-13 改版并收编进容器内 crond）：S3 逻辑备份——rclone 直连
# SeaweedFS S3 API（s3weed remote，SEAWEED_S3_* 由 compose 注入）镜像 avatars/nearby
# 素材到 B2，剔除了可经 Jenkins 重建的 sites/ 前端编译产物；备份后按
# FS_RETENTION_DAYS（默认 3 天）清理 B2 端超期对象。原 tar 整卷方案废弃
# （活动写入一致性风险 + 无法剔除可重建数据），宿主机 crontab 的一次性容器行已删除。
30 4 * * * /app/backup/backup-filesystem.sh >> /var/log/noda-backup/filesystem.log 2>&1

# 每周日 4:50 收敛备份日志（防 /var/log/noda-backup 卷无限增长；单文件 >5MB 截到 1MB）
50 4 * * 0 find /var/log/noda-backup -name "*.log" -size +5000k -exec truncate -s 1M {} \; 2>/dev/null || true

# 爬虫任务（2026-09-13 定案）：全部产品 cronjob（skykiwi 抓取/nearby/snagme/
# lifecycle/vitals）由 noda-api 镜像的 noda-jobs 守护进程容器承载
# （Jenkins apps-deploy LAYER=api 随 api 容器一并部署），本镜像不再涉及。

# 注意：Docker 镜像清理在 r4s 宿主机上通过 cron 执行
# 文件位置：/opt/noda/cleanup-docker-images.sh
# 执行时间：每周日凌晨 5:00 (root crontab)
