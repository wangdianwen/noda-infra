# R4S 宿主机 crontab（iStoreOS，root）
# 2026-09-13 cronjob 集中收口后的最终形态：
#   - 全部产品 cronjob（skykiwi 抓取 / nearby / snagme / lifecycle / vitals）
#     由 noda-api 镜像的 noda-jobs 守护进程容器承载（Jenkins apps-deploy 部署，
#     Pacific/Auckland 时区 DST 自适应，本机时区不再需要 NZDT 手工 +1h）
#   - 文件系统备份收编进 noda-ops 容器内 crond（deploy/crontab，rclone S3 逻辑备份）
#   - 本文件只剩宿主机职责项：docker 镜像清理 + noda 日志收敛
#     + hermes 残留会话看门狗 + OpenClash 周重启（2026-09-29 内存治理新增）
#
# 安装：scp 本文件到 r4s 后执行 `crontab deploy/crontab-r4s-host`
# 注意：iStoreOS 无 logrotate，日志收敛用 find + truncate；BusyBox crond

# ===== Docker 镜像清理（每周日 05:00，防止 / 1.9G 分区被旧镜像吃满）=====
0 5 * * 0 /opt/noda/cleanup-docker-images.sh >> /var/log/noda-cleanup-docker.log 2>&1

# ===== noda 日志收敛（每天 04:45；>5MB 截到 1MB，30 天前的删除）=====
45 4 * * * find /var/log -name "noda-*.log" -size +5000k -exec truncate -s 1M {} \; 2>/dev/null; find /var/log -name "noda-*.log" -mtime +30 -delete 2>/dev/null

# ===== （已移除，2026-09-13 集中化）=====
# snagme tick / nearby 五 job / skykiwi 四 job → noda-jobs 守护进程容器
# SeaweedFS tar 备份（04:30 docker run 一次性容器）→ noda-ops 容器内 crond

# ===== hermes 残留会话看门狗（每小时；杀运行超 24h 的裸 `hermes` chat 进程，脚本在
#       r4s:/root/.hermes/scripts/kill-stale-hermes-chat.sh，gateway 不受影响）=====
15 * * * * /root/.hermes/scripts/kill-stale-hermes-chat.sh

# ===== OpenClash 周重启（每周一 04:00；clash 运行时内存约 20 天涨到 280MB，周重启清零）=====
0 4 * * 1 /etc/init.d/openclash restart >/dev/null 2>&1

# ===== 数据盘→备份盘整盘快照（每天 05:10；硬链接增量，保留 2 代，脚本在
#       r4s:/mnt/mmc1-4/System/Scripts/backup-snapshot.sh；2026-10-02 目录功能化
#       重组后路径由 /mnt/mmc1-4/scripts/ 迁至 System/Scripts/）=====
10 5 * * * /mnt/mmc1-4/System/Scripts/backup-snapshot.sh >> /var/log/noda-snapshot.log 2>&1

# ===== Immich 缩略图自愈（每小时；修上传链路不写 asset_job_status 的产品 bug：
#       回填状态行 + 视频缺流信息二次提取 + missing-only 补队；负载>8 自动跳过。
#       脚本 r4s:/mnt/mmc1-4/System/Scripts/immich-thumb-heal.sh，
#       凭证 .immich-ops-token（同目录 600）。2026-10-03 缩略图缺失排查新增）=====
40 * * * * /mnt/mmc1-4/System/Scripts/immich-thumb-heal.sh >> /var/log/noda-immich-heal.log 2>&1

# ===== 统一百度云同步（每天 03:30）：配置整树增量（先，秒级）+ 照片两树增量/DB 转储（后；
#       纯单文件架构——BaiduPCS-Go v4.0.2 目录上传全灭，本地状态差集只传新/变文件，秒传防重复；
#       161G 基线期间内部锁自动跳过当日重入；登录失效/上传失败自动 Telegram 告警。
#       入口 r4s:/mnt/mmc1-4/System/Scripts/baidu-sync-all.sh，分见
#       system-config-backup.sh（v4 整树单副本）与 immich-cloud-upload.sh（v2 增量）。
#       2026-10-03 由单一照片 cron 升级为统一入口）=====
30 3 * * * /mnt/mmc1-4/System/Scripts/baidu-sync-all.sh >> /var/log/noda-baidu-sync-all.log 2>&1

# ===== 百度上传僵死看门狗（每 10 分钟）：实例在跑但 90 分钟无文件完成（连接僵死，
#       BaiduPCS-Go 对吊死连接不超时）→ 杀掉重启（断点续传+秒传）+ Telegram 告警。
#       2026-10-03 基线期间发现连接可僵死 2.5h 无任何重试/报告，新增）=====
*/10 * * * * /mnt/mmc1-4/System/Scripts/baidu-upload-watchdog.sh

# ===== weed swap 债守卫（每 10 分钟）：核对 seaweedfs cgroup memory.swap.max=0，
#       漂移（recreate/带外启动）自动重设 + TG 告警。背景：2026-10-04 33s manifest
#       GET 事故——weed 149MB 热内存压在与数据同盘（sda2）的 swapfile 上；本机
#       docker 不支持 swap limit（memswap_limit 被引擎丢弃），禁 swap 只能 cgroup
#       直写且容器 recreate 会重置。脚本 r4s:/mnt/mmc1-4/System/Scripts/weed-swap-guard.sh =====
*/10 * * * * /mnt/mmc1-4/System/Scripts/weed-swap-guard.sh >> /var/log/noda-weed-guard.log 2>&1

# ===== weed S3 假死守卫（每 5 分钟）：直探 S3 :8333，连续 2 轮连不上/超时
#       （403/404 等应用层响应=活着）自动 docker restart + TG。背景：2026-10-04
#       #571 发版 26k PUT 风暴触发 vacuum 卡死整个 weed 进程，线上 502 22 分钟
#       ——healthcheck 早已报 unhealthy 但无人响应。脚本
#       r4s:/mnt/mmc1-4/System/Scripts/weed-watchdog.sh（存档 deploy/weed-watchdog.sh）=====
*/5 * * * * /mnt/mmc1-4/System/Scripts/weed-watchdog.sh >> /var/log/noda-weed-guard.log 2>&1
