<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>Label</key>
	<string>com.noda.gate-bot-watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/bash</string>
		<string>-c</string>
		<string>cd $HOME/project/website-gate &amp;&amp; set -a &amp;&amp; . $HOME/project/website-gate/credentials/tg.env &amp;&amp; set +a &amp;&amp; exec /opt/homebrew/bin/uv run python ops/bot_watch.py &gt;&gt; logs/bot-watch.log 2&gt;&amp;1</string>
	</array>
	<key>StandardErrorPath</key>
	<string>/Users/dianwenwang/project/website-gate/logs/bot-watch.log</string>
	<key>StandardOutPath</key>
	<string>/Users/dianwenwang/project/website-gate/logs/bot-watch.log</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
